# ---------------------------------------------------------------
# Per-machine settings. NOT versioned.
#
# Edit these values: they are local and do NOT affect the other
# machine that clones the same repo. Hyprland reads them at every
# startup and on every "hyprctl reload".
#
# To apply a change: edit this file -> hyprctl reload
# ---------------------------------------------------------------

# ---- Monitors ----

# Internal display (only relevant if more than one is connected).
PRIMARY_MONITOR=eDP-1
# Scaling factor (DPI) of the internal display.
PRIMARY_SCALE=1.5

# External monitors NO se configuran acá: se identifican por su EDID ('desc:') y
# viven en ~/.local_host_monitors, otro archivo local de ESTA máquina (el repo trae
# la plantilla templates/local_host_monitors). Esa identidad es la misma sin importar
# el puerto (DP-1, USB-C, HDMI). Las viejas claves EXTERNAL_MONITOR / EXTERNAL_MODE /
# EXTERNAL_POSITION / EXTERNAL_SCALE quedaron en desuso.
# Para sumar un monitor nuevo: enchuflo -> 'monitor-id' -> pegar el bloque.

# ---- Mouse / Keyboard ----

# XKB layouts, comma-separated; toggle between them with the key combo in KB_OPTIONS.
KB_LAYOUT=latam,es
# XKB layout variant (usually empty: "", or e.g. "dvorak").
KB_VARIANT=
# XKB option that switches layout on a key combo (e.g. grp:alt_shift_toggle).
KB_OPTIONS=grp:alt_shift_toggle
# XKB keyboard model (usually empty; e.g. "thinkpad60" for some ThinkPads).
KB_MODEL=

# ---- Effects (perf trade-offs on this iGPU; false = disabled) ----

# Window drop shadows.
SHADOWS_ENABLED=false
# Background blur behind translucent windows.
BLUR_ENABLED=false
# Animate workspace switching (offsets the cost when switching fast).
WORKSPACE_ANIMATIONS=false
# Redraw frames while resizing/dragging windows.
ANIMATE_RESIZES=false

# ---- Mouse: cursor and touchpad ----

# Cursor size in pixels (HiDPI displays want a bigger one).
CURSOR_SIZE=24
# Whether touchpad scrolling is "natural" (two-finger swipe acts as scroll-up).
TOUCHPAD_NATURAL_SCROLL=true
# Global pointer sensitivity, -1.0 to 1.0; 0 = unchanged.
MOUSE_SENSITIVITY=0

# ---- Mouse: per-device overrides ----
# Only the devices listed below get these settings; all others stay default.
# Add as many devices as you want by repeating the MOUSE_DEVICE_<n>_ group
# (1, 2, 3...) with NAME + only the options you want. Empty/missing NAME = ignored.
# Name must match exactly what Hyprland reports (`hyprctl devices -j`), or you
# can pin a specific physical unit with "address:...".
MOUSE_DEVICE_1_NAME=logitech-mx-anywhere-3s
MOUSE_DEVICE_1_LEFT_HANDED=true
MOUSE_DEVICE_1_SENSITIVITY=-0.5
# Optional per-device options: NATURAL_SCROLL, ACCEL_PROFILE (flat/adaptive),
# SCROLL_METHOD (on_button_down/on_button_up/edge/no_scroll), ENABLED.
# MOUSE_DEVICE_2_NAME=other-device-here
# MOUSE_DEVICE_2_LEFT_HANDED=false