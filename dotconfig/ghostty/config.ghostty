# Configuracion de ghostty.
# Vive en ~/config_files/dotconfig/ghostty y se enlaza como ~/.config/ghostty
# desde archdesktopinstall.sh (seccion 9).
#
# La paleta es la misma que usan waybar (style.css) y mako: escala zinc
# (#18181b / #27272a / #3f3f46 / #52525b) con acento cyan #75f1fa y el rojo
# #e35149 de los estados urgentes.

# --- Tipografia ---
# La variante Nerd Font es la que trae los glifos (iconos de powerline, git,
# devicons). El paquete ttf-jetbrains-mono-nerd la registra con este nombre
# exacto; "JetBrains Mono" a secas es la familia sin glifos.
font-family = JetBrainsMono Nerd Font
font-size = 12

# --- Ventana ---
window-padding-x = 10
window-padding-y = 8
# Transparencia sutil, igual que las notificaciones de mako.
background-opacity = 0.96

# --- Colores base ---
# #27272a es el @dark-8 de waybar, el fondo de sus modulos. Un escalon mas
# claro que el #18181b de la barra, que resultaba demasiado oscuro.
background = #27272a
foreground = #fafafa
cursor-color = #75f1fa
cursor-style = block
# Un escalon mas que el fondo para que la seleccion se distinga: contra
# #27272a, el #3f3f46 quedaba casi invisible.
selection-background = #52525b
selection-foreground = #fafafa

# --- Paleta ANSI ---
# 0-7: colores normales
# El negro es #18181b (el @dark-9 de la barra): tiene que ser MAS oscuro que
# el fondo, si no el texto en color 0 quedaria invisible.
palette = 0=#18181b
palette = 1=#e35149
palette = 2=#7ee787
palette = 3=#e3b341
palette = 4=#79c0ff
palette = 5=#d2a8ff
palette = 6=#75f1fa
palette = 7=#d4d4d8
# 8-15: variantes brillantes
palette = 8=#52525b
palette = 9=#ff7b72
palette = 10=#8ef0a0
palette = 11=#f0c674
palette = 12=#a5d6ff
palette = 13=#e2c5ff
palette = 14=#a5f6fc
palette = 15=#fafafa

# --- Comportamiento ---
mouse-hide-while-typing = true
