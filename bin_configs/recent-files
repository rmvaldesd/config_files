#!/usr/bin/env bash
# Shows recent files under ~ in a rofi menu and lets you act on the chosen one: open,
# copy its path, open the folder, open a terminal there, or move it to the trash.
# Keybind: SUPER + O.
#
# Where "recent" comes from, in order of trust:
#
#   1. recently-used.xbel   (~/.local/share/recently-used.xbel)                    [app]
#      The files GTK apps recorded when opening them. It is the cleanest signal and it is
#      not limited to any folder: a download and a file under ~/Sources both show up.
#      There are ~91 entries today and ~41 survive (the rest no longer exist).
#   2. Downloads            (~/Downloads)                                     [download]
#   3. Screenshots          (~/Pictures/screenshots)                         [screenshot]
#   4. Touched              files touched in the last days under ~      [created/modified]
#      This is noise by nature, so it uses a short window and a cap. Worse: without
#      excluding the browser profiles, ~6000 of ~7700 touched files in 3 days are Chrome
#      and Firefox rewriting state. With the exclusions below, what is left is the files
#      actually touched (Sources/*, obsidian-vaults, config_files, ...).
#      Each one is split by BIRTH time: if the file was born at (almost) the same moment
#      it was last written, the recent event is a creation -> 'created'; otherwise it is an
#      existing file that was edited -> 'modified'.
#
# Each row carries its category and is deduplicated by path: if a file falls in two
# sources, the more specific one wins (screenshot > download > app > created/modified). The
# folder says more than "an app opened it": a screenshot or a download is labeled as such
# even if it is also in the xbel or was touched.
#
# thunar has no --select, so "open the folder" opens the containing directory, not the
# file highlighted. That is what there is.
#
# It is pure rofi (with -kb-custom-*), so it needs no terminal: it works the same launched
# from the keybind or by hand.

set -euo pipefail

# Window and cap for the "modified" category. Chosen by measuring on this machine: 3 days
# with the exclusions below give ~320 entries, generated in ~60 ms.
modified_window="3d"
modified_cap=400

# Same base exclusions as find-file / the fzf widgets of zshrc.local (caches and state of
# apps and frameworks). If you touch one, touch the others.
#
# The second block is OWN to recent-files: state and churn of applications that are not
# "files the user touched". Without it, "modified" would be ~90% the browser database, the
# Firefox profile and Obsidian/DBeaver/az state.
exclude=(
    --exclude=.git
    --exclude=.cache
    --exclude=.cargo
    --exclude=.claude
    --exclude=.local/share
    --exclude=.local/state

    --exclude=go/pkg
    --exclude=.npm
    --exclude=node_modules
    --exclude=.oh-my-zsh

    # --- application churn (recent-files only) ---
    --exclude=.config/google-chrome
    --exclude=.config/chromium
    --exclude=.config/mozilla
    --exclude=.config/obsidian
    --exclude=.config/draw.io
    --exclude=.config/BraveSoftware
    --exclude=.config/vivaldi
    --exclude=.config/Code
    --exclude=.mozilla
    --exclude=.eclipse
    --exclude=.azure
    --exclude=.vscode-server
    --exclude=.cursor
    --exclude=.bun
    --exclude=.deno
    --exclude=.gradle
    --exclude=.m2
    --exclude=.rustup
    --exclude=.claude.json
    --exclude=.config/herdr
)

notify() {
    local message=$1
    notify-send "Recent" "$message" 2> /dev/null || printf '%s\n' "$message" >&2
}

# The xbel hrefs come percent-encoded ('%20' for a space), and for a PATH that has to be
# decoded. It is only decoded if ALL the '%' are a valid escape and there are no
# backslashes (unlike a URL, here it does apply; see find-file).
decode() {
    local r=$1
    if [[ $r == *%* && $r != *\\* ]] &&
       [[ ! $r =~ %[^0-9A-Fa-f] && ! $r =~ %$ ]]; then
        r=$(printf '%b' "${r//%/\\x}")
    fi
    printf '%s' "$r"
}

# Every source prints lines 'epoch <TAB> priority <TAB> category <TAB> path'.
# The priority breaks the dedup tie by path (higher = more specific).
list_xbel() {
    local xbel="$HOME/.local/share/recently-used.xbel"
    [ -f "$xbel" ] || return 0

    grep -o '<bookmark [^>]*>' "$xbel" 2> /dev/null |
        while IFS= read -r tag; do
            local encoded path when epoch
            encoded=$(sed -n 's/.*href="file:\/\/\([^"]*\)".*/\1/p' <<< "$tag")
            [ -n "$encoded" ] || continue
            path=$(decode "$encoded")
            [ -f "$path" ] || continue
            when=$(sed -n 's/.*modified="\([^"]*\)".*/\1/p' <<< "$tag")
            epoch=$(date -d "$when" +%s 2> /dev/null) || continue
            printf '%s\t2\tapp\t%s\n' "$epoch" "$path"
        done || true
}

list_dir() {
    local dir=$1 priority=$2 category=$3
    [ -d "$dir" ] || return 0

    find "$dir" -maxdepth 1 -type f -printf '%T@\t%p\n' 2> /dev/null |
        while IFS=$'\t' read -r epoch path; do
            # %T@ brings decimals; they are cut so arithmetic can be done later.
            printf '%s\t%s\t%s\t%s\n' "${epoch%%.*}" "$priority" "$category" "$path"
        done || true
}

list_modified() {
    # fd filters by date and exclusions (fast, in parallel), and stat provides the real
    # epoch so it can be mixed and sorted against the other sources. Measured: ~60 ms.
    #
    # MIND stat's format: 'stat -c' does NOT interpret '\t', it leaves it as two characters
    # and the column shifts (this was a real bug). A real tab has to be passed with $'...'.
    # 'find -printf', on the other hand, does interpret '\t' (that is why list_dir uses a
    # plain '\t').
    fd --type f --hidden --follow --changed-within "$modified_window" \
        "${exclude[@]}" -0 . "$HOME" 2> /dev/null |
        xargs -0 -r stat -c $'%Y\t%W\t%n' 2> /dev/null |
        while IFS=$'\t' read -r epoch birth path; do
            # birth (%W) is 0 when the filesystem does not record it. If the file was born
            # at (almost) the same moment it was last written, the recent event is a
            # CREATION; otherwise an existing file was edited. 300 s of slack absorbs a
            # file that took a while to be fully written, but still counts a file edited
            # long after it was made as 'modified'.
            category=modified
            if [ "${birth:-0}" -gt 0 ] && [ $(( epoch - birth )) -le 300 ]; then
                category=created
            fi
            printf '%s\t1\t%s\t%s\n' "$epoch" "$category" "$path"
        done |
        sort -rn | head -n "$modified_cap" || true
}

# How long ago, in short form. No 'date -d @epoch' at all: that would be one fork per row
# and, worse, a full date like '2026-07-27' (10 chars) would blow up the fixed-width age
# column. The units cap at 4 chars ('now', '59m', '23h', '6d', '3w', '11mo', '1y').
time_ago() {
    local secs=$(( $(date +%s) - $1 ))
    if   [ "$secs" -lt 60 ];        then printf 'now'
    elif [ "$secs" -lt 3600 ];      then printf '%dm'  "$((secs / 60))"
    elif [ "$secs" -lt 86400 ];     then printf '%dh'  "$((secs / 3600))"
    elif [ "$secs" -lt 604800 ];    then printf '%dd'  "$((secs / 86400))"
    elif [ "$secs" -lt 2592000 ];   then printf '%dw'  "$((secs / 604800))"
    elif [ "$secs" -lt 31536000 ];  then printf '%dmo' "$((secs / 2592000))"
    else printf '%dy' "$((secs / 31536000))"
    fi
}

open_file() {
    setsid -f xdg-open "$1" > /dev/null 2>&1
}

copy_path() {
    printf '%s' "$1" | wl-copy
    notify "Path copied: $1"
}

open_folder() {
    setsid -f xdg-open "$(dirname -- "$1")" > /dev/null 2>&1
}

open_terminal() {
    setsid -f foot -D "$(dirname -- "$1")" > /dev/null 2>&1
}

trash_file() {
    local answer
    answer=$(printf 'No\nYes\n' | rofi -dmenu -i -p "Move to the trash?" \
        -theme-str 'window {width: 500px;}') || return 0
    [ "$answer" = "Yes" ] || return 0
    if gio trash "$1" 2> /dev/null; then notify "To the trash: $(basename -- "$1")"
    else notify "Could not move: $1"; fi
}

# Asked for by Alt+0 (rofi exits with 19): the entry door for whoever does not remember
# the keys.
action_menu() {
    local path=$1 action
    action=$(printf '%s\n' "Open" "Copy path" "Open folder" "Open terminal" \
        "Move to the trash" |
        rofi -dmenu -i -p "What do I do?" -theme-str 'window {width: 420px;}') || return 0
    case "$action" in
        "Open")              open_file "$path" ;;
        "Copy path")         copy_path "$path" ;;
        "Open folder")       open_folder "$path" ;;
        "Open terminal")     open_terminal "$path" ;;
        "Move to the trash") trash_file "$path" ;;
    esac
}

# Build the list: gather the sources, deduplicate by path keeping the highest-priority
# row, sort by date desc and translate to the columns rofi sees.
rows=$(
    {
        list_xbel
        list_dir "$HOME/Downloads" 3 download
        list_dir "$HOME/Pictures/screenshots" 4 screenshot
        list_modified
    } |
    awk -F'\t' '
        { if (!($4 in best) || $2 > best[$4]) { best[$4] = $2; row[$4] = $0 } }
        END { for (path in row) print row[path] }
    ' |
    sort -rn |
    while IFS=$'\t' read -r epoch _priority category path; do
        name=$(basename -- "$path")
        folder=$(dirname -- "$path")
        # The '~' of the replacement goes quoted: bare, bash expands it (see find-file).
        folder=${folder/#"$HOME"/"~"}

        # Truncate the name so the columns after it start at a fixed position. rofi does
        # NOT align columns across rows (it just puts a separator), so a long name pushes
        # everything to the right. '...' is ASCII on purpose: an ellipsis would add 3 bytes
        # and break the padding.
        if [ "${#name}" -gt 30 ]; then name="${name:0:27}..."; fi

        # ONE padded column, not rofi's -display-columns: alignment has to be built here.
        # Fields: name(30) category(10) age(4, right) folder(last, free). The path stays as
        # the hidden first column and is what the script reads back.
        printf '%s\t%-30s  %-10s  %4s  %s\n' \
            "$path" "$name" "$category" "$(time_ago "$epoch")" "$folder"
    done
)

if [ -z "$rows" ]; then
    notify "No recent files"
    exit 0
fi

# Enter opens (0); the custom ones are 10.. (custom-1 = 10, custom-10 = 19).
rofi_args=(
    -dmenu -i
    -p "Recent"
    -display-columns 2
    -kb-custom-1 "Alt+1"
    -kb-custom-2 "Alt+2"
    -kb-custom-3 "Alt+3"
    -kb-custom-4 "Alt+4"
    -kb-custom-10 "Alt+0"
    -mesg "Enter opens · Alt+1 path · Alt+2 folder · Alt+3 terminal · Alt+4 trash · Alt+0 more"
    -theme-str 'window {width: 1100px;}'
)

# The '|| rc=$?' keeps 'set -e' from cutting the script: the code is needed to know which
# key was pressed. rofi still prints the chosen row, so it comes out of stdout.
rc=0
selection=$(printf '%s\n' "$rows" | rofi "${rofi_args[@]}") || rc=$?

[ -n "$selection" ] || exit 0
path=${selection%%$'\t'*}

case "$rc" in
    0)  open_file     "$path" ;;
    10) copy_path     "$path" ;;
    11) open_folder   "$path" ;;
    12) open_terminal "$path" ;;
    13) trash_file    "$path" ;;
    19) action_menu   "$path" ;;
    *)  exit 0 ;;
esac
