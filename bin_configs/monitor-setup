#!/usr/bin/env lua5.4
-- monitor-setup - TUI to configure monitors (external and the internal panel) by
-- EDID identity, built on the vendored LTUI (bin_configs/ltui/, Apache-2.0,
-- github.com/tboox/ltui).
--
-- Lists every connected monitor, flags the ones with no profile yet (NEW), and
-- lets you pick resolution, position, scale, rotation, workspaces and output mode
-- to save into ~/.local_host_monitors (this machine's LOCAL monitor file, outside
-- the repo). Saving runs a 'hyprctl reload', so the profile applies right away.
-- 'd' removes a saved profile and 'R' re-reads the monitors. The internal display
-- gets a profile like any other; it just has no "Position" row (it is the origin).
--
-- If ~/.local_host_monitors does not exist when the screen opens, it is created
-- from the repo template (or with the default fallback if the template is also
-- missing) - the first run never fails on the file. If the file exists but does
-- not load, the problem is shown and saving is disabled, so a typo in the local
-- file never eats the saved profiles (the previous copy stays as a .bak).
--
-- It opens in a centered floating terminal (window rule 'monitor-setup-flotante'
-- and SUPER + F2 in hyprland.lua):
--   foot --title=monitor-setup -e monitor-setup
--
-- 'desc:' comes from the monitor's physical EDID and does NOT depend on the
-- port: DP-1, USB-C or HDMI-A-1 report the same value for the same monitor, so
-- the profile follows it across ports. Every monitor without its own profile
-- uses the 'fallback' block.
--
-- Requires: hyprctl + jq, lua 5.4 and the vendored LTUI. The C binding
-- (bin_configs/ltui/lcurses.so) is built once with scripts/build-ltui.sh; LTUI
-- itself does not build on Lua 5.4 without that step (uses luaL_checkint,
-- removed in 5.4).

-- --------------------------------------------------------------------------
-- Resolve the repo dir (the script may be run through a /usr/local/bin symlink)
-- --------------------------------------------------------------------------
local function script_dir()
    local p = arg and arg[0]
    if p then
        local handle = io.popen("readlink -f -- '" .. tostring(p):gsub("'", "'\\''") .. "' 2>/dev/null")
        if handle then
            local rp = handle:read("*l")
            handle:close()
            if rp and rp ~= "" then
                p = rp
            end
        end
        local d = tostring(p):match("^(.*)/[^/]*$")
        if d and d ~= "" then
            return d
        end
    end
    local src = (debug.getinfo(1, "S").source or ""):gsub("^@", "")
    return src:match("^(.*)/[^/]*$") or "."
end

local BIN_DIR = script_dir()
package.path = BIN_DIR .. "/?.lua;" .. BIN_DIR .. "/?/init.lua;" .. package.path
package.cpath = BIN_DIR .. "/?.so;" .. package.cpath

local oklib, lib = pcall(require, "monitor-setup-lib")
if not oklib then
    io.stderr:write("ERROR: cannot load monitor-setup-lib.lua\n")
    io.stderr:write(tostring(lib) .. "\n")
    os.exit(1)
end

local oktui, ltui = pcall(require, "ltui")
if not oktui then
    io.stderr:write("ERROR: the vendored LTUI did not load.\n")
    io.stderr:write("The C binding is missing or was built for another Lua.\n")
    io.stderr:write("Build it once with:  bash " .. BIN_DIR .. "/../scripts/build-ltui.sh\n")
    os.exit(1)
end

local view, rect, event, action = ltui.view, ltui.rect, ltui.event, ltui.action
local application = ltui.application
local choicedialog, textdialog = ltui.choicedialog, ltui.textdialog

-- Rotation / flip (Hyprland 'transform' 0..7). ASCII only (byte-width safe).
local TRANSFORMS = {
    { v = 0, name = "Normal" },
    { v = 1, name = "90 (portrait left)" },
    { v = 2, name = "180 (upside down)" },
    { v = 3, name = "270 (portrait right)" },
    { v = 4, name = "Flipped" },
    { v = 5, name = "Flipped + 90" },
    { v = 6, name = "Flipped + 180" },
    { v = 7, name = "Flipped + 270" },
}

local function transform_name(v)
    v = tonumber(v) or 0
    for _, t in ipairs(TRANSFORMS) do
        if t.v == v then
            return t.name
        end
    end
    return "Normal"
end

-- The editable rows of the selected monitor, in order (navigated with j/k and
-- opened with Enter; no per-field letter shortcut needed). The internal display
-- has no "Position" row: it is the layout origin, so a relative position is moot.
local OPTIONS_EXTERNAL = { "Resolution", "Position", "Scale", "Rotation", "Workspaces", "Output" }
local OPTIONS_INTERNAL = { "Resolution", "Scale", "Rotation", "Workspaces", "Output" }

-- Serialize the current draft of 'desc' into a hl.monitor({...}) Lua snippet,
-- used for the live preview (applied with 'hyprctl eval').
local function rule_lua(desc, d)
    local fields = { 'output = "' .. tostring(desc):gsub('"', '\\"') .. '"' }
    if d.disabled then
        fields[#fields + 1] = "disabled = true"
    else
        fields[#fields + 1] = "disabled = false"
        fields[#fields + 1] = 'mode = "' .. tostring(d.mode):gsub('"', '\\"') .. '"'
        fields[#fields + 1] = 'position = "' .. tostring(d.position):gsub('"', '\\"') .. '"'
        if type(d.scale) == "number" then
            fields[#fields + 1] = "scale = " .. tostring(d.scale)
        else
            fields[#fields + 1] = 'scale = "' .. tostring(d.scale):gsub('"', '\\"') .. '"'
        end
        local tr = tonumber(d.transform) or 0
        fields[#fields + 1] = "transform = " .. tostring(math.floor(tr))
        if d.mirror and d.mirror ~= "" then
            fields[#fields + 1] = 'mirror = "' .. tostring(d.mirror):gsub('"', '\\"') .. '"'
        end
    end
    return "hl.monitor({ " .. table.concat(fields, ", ") .. " })"
end

-- --------------------------------------------------------------------------
-- Helpers
-- --------------------------------------------------------------------------

-- Left-justify to n columns, cutting with an ellipsis when it does not fit.
local function ellip(s, n)
    s = tostring(s or "")
    n = math.floor(n)
    if n <= 0 then
        return ""
    end
    if #s <= n then
        return s
    end
    if n <= 3 then
        return s:sub(1, n)
    end
    return s:sub(1, n - 3) .. "..."
end

local function pad(s, n)
    s = ellip(s, n)
    if #s < n then
        return s .. string.rep(" ", n - #s)
    end
    return s
end

-- Connected-monitor signature: changes when a monitor is plugged/unplugged.
local function monitor_signature(monitors)
    local parts = {}
    for _, m in ipairs(monitors) do
        parts[#parts + 1] = m.name .. ":" .. m.desc
    end
    return table.concat(parts, "|")
end

-- Statusbar legend: only navigation + help (the feature keys live in the help).
local function status_legend(w)
    if w >= 54 then
        return " [j/k] move   [tab] area   [enter] edit   [h] help   [q] quit"
    end
    return " [j/k] move   [h] help   [q] quit"
end

