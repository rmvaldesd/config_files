#!/usr/bin/env bash
# Selector de ventanas del workspace ACTUAL, con rofi.
# Invocado por el bind SUPER+W en hyprland.lua.
#
# Por qué un script y no 'rofi -show window' a secas: ese modo lista las ventanas de
# TODOS los workspaces, sin forma de filtrarlas. Y 'windowcd' -- el modo del rofi
# clásico que sí filtraba por escritorio actual -- no existe en el fork de Wayland
# (rofi 2.x): bajo Wayland rofi usa el protocolo wlr-foreign-toplevel, que no expone
# a qué workspace pertenece cada ventana. La info sí la tiene Hyprland, así que se la
# pedimos a él y usamos rofi sólo como menú.

set -euo pipefail

ws=$(hyprctl -j activeworkspace | jq -r '.id')

# Formato: "dirección<TAB>etiqueta visible". La dirección viaja pegada a cada línea
# para no tener que re-buscar la ventana por título (que puede repetirse o cambiar
# entre que se muestra el menú y se elige).
lista=$(hyprctl -j clients | jq -r --argjson ws "$ws" '
    .[]
    | select(.workspace.id == $ws)
    | select(.title != "")
    | "\(.address)\t\(.class)\t\(.title)"
')

if [ -z "$lista" ]; then
    # Sin ventanas no tiene sentido abrir el menú; un aviso y afuera.
    notify-send "Ventanas" "No hay ventanas en el workspace $ws" 2> /dev/null || true
    exit 0
fi

# -display-columns 2,3 hace que rofi MUESTRE sólo clase y título, pero devuelva la
# línea entera: así la dirección queda disponible sin ensuciar el menú.
# -i para búsqueda insensible a mayúsculas, como el resto de los menús del entorno.
seleccion=$(printf '%s\n' "$lista" | rofi -dmenu -i \
    -p "Ventanas (ws $ws)" \
    -display-columns 2,3 \
    -theme-str 'window {width: 700px;}') || exit 0

[ -n "$seleccion" ] || exit 0

direccion=${seleccion%%$'\t'*}
hyprctl dispatch focuswindow "address:$direccion" > /dev/null
