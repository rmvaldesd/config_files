#!/usr/bin/env bash
# Busca un archivo en cualquier lugar de ~ y lo abre con su aplicación por defecto.
# Un solo script con dos caras, según desde dónde se lo llame:
#
#   find-file          elige solo: rofi si lo lanzó el bind (SUPER + F), fzf si lo
#                      corriste en una terminal
#   find-file --rofi   fuerza el menú de rofi
#   find-file --fzf    fuerza fzf con preview (permite elegir varios con Tab)
#
# Desde el bind (SUPER + F), la cara rofi además mira el portapapeles: si lo último
# copiado es una ruta o una URL, la ofrece ARRIBA y preseleccionada, así Enter sin
# escribir nada abre eso (ver el bloque "Lo que tengas copiado" más abajo). La cara fzf
# no lo hace a propósito. Ver las funciones limpiar_basico/limpiar_ruta/es_url/
# analizar_candidato.
#
# La detección es por TTY y no por variables de entorno: Hyprland lanza los binds sin
# terminal, así que ahí stdin no es un tty y sale rofi; en una terminal interactiva sí
# lo es y sale fzf. Es el único dato confiable -- WAYLAND_DISPLAY, por ejemplo, está
# puesto en las DOS situaciones, porque la terminal también es un cliente de Wayland.
#
# Por qué un script y no 'rofi -show recursivebrowser' (que existe en rofi 2.0 y abre
# con xdg-open por su cuenta): ese modo usa su propio escáner, sin forma de excluir
# nada. Termina listando las decenas de miles de archivos de caché de este disco, que
# no son cosas que uno quiera abrir, y sepultando bajo ellos a los que sí. Con fd los
# excluimos y quedan ~4.700 entradas reales, que se generan en menos de 100 ms.

set -euo pipefail

frontend=auto
case "${1:-}" in
    --rofi) frontend=rofi ;;
    --fzf)  frontend=fzf ;;
    "")     ;;
    *)      printf 'uso: %s [--rofi|--fzf]\n' "$0" >&2; exit 1 ;;
esac

if [ "$frontend" = auto ]; then
    if [ -t 0 ] && [ -t 1 ]; then frontend=fzf; else frontend=rofi; fi
fi

# --hidden es necesario: fd salta los ocultos de fábrica y sin esto ~/.config, que sí
# se edita a mano, quedaría invisible. Justamente por eso hay que sacar a mano los
# directorios ocultos que son caché o estado de las apps.
#
# Esta lista es la MISMA que la de los widgets de fzf de zshrc.local (_fzf_home_ex_fd),
# a propósito: que buscar desde la terminal y buscar desde el escritorio no devuelvan
# universos distintos. Si tocás una, tocá la otra.
#
# El segundo bloque son cachés de dependencias, y es el que más cambia las cosas: sin
# él, el caché de módulos de Go solo aporta 27.216 de las 34.336 entradas -- el 79% del
# menú -- y sepulta a lo que uno busca. Medido acá: 34.336 entradas contra 4.724.
excluir=(
    --exclude=.git
    --exclude=.cache
    --exclude=.cargo
    --exclude=.claude
    --exclude=.local/share
    --exclude=.local/state

    --exclude=go/pkg      # caché de módulos de Go, de sólo lectura
    --exclude=.npm        # caché de npm
    --exclude=node_modules
    --exclude=.oh-my-zsh  # código del framework, no configuración propia
)

# fd corre DESDE ~ para que emita rutas relativas: son las que se ven mejor en los dos
# menús ('Documents/informe.pdf' y no '/home/rodrigo/Documents/informe.pdf') y además
# hacen que el preview de fzf funcione sin reconstruir nada, porque fzf hereda este
# mismo directorio. La ruta absoluta la repone abrir().
cd "$HOME"

# Devuelve la ruta ABSOLUTA de lo que le pasen. Acepta las tres formas que llegan acá:
# la relativa a ~ que produce la lista de fd ('Documents/x.pdf'), una absoluta tipeada a
# mano ('/etc/hosts') y una con '~' ('~/x'). Antes esto se resolvía anteponiendo $HOME a
# TODO sin mirar, así que '/etc/hosts' terminaba en '/home/rodrigo//etc/hosts' y '~/x'
# en '/home/rodrigo/~/x': tipear una ruta absoluta en el menú no funcionaba.
resolver() {
    local r=$1
    case "$r" in
        "~")   r=$HOME ;;
        # ${r:2} y no ${r#~/}: igual que en 'case', bash expandiría la tilde del
        # patrón '~/' y no recortaría nada, dejando '$HOME/~/x'.
        "~/"*) r="$HOME/${r:2}" ;;
    esac
    realpath -m -- "$r"
}

# Limpieza COMÚN a cualquier candidato: saca los adornos con los que suele venir lo
# copiado, sirva después como ruta o como URL. CR final (copiado de Windows), espacios
# al costado, comillas envolventes y los '<...>' de un mail o un markdown.
limpiar_basico() {
    local r=$1

    r=${r%$'\r'}
    r=${r#"${r%%[![:space:]]*}"}
    r=${r%"${r##*[![:space:]]}"}
    r=${r#\"}; r=${r%\"}
    r=${r#\'}; r=${r%\'}
    # '<https://...>' sólo si están los DOS, para no comerse un '>' suelto.
    case "$r" in "<"*">") r=${r#<}; r=${r%>} ;; esac

    printf '%s' "$r"
}

# ¿Es una URL? Cualquier esquema con autoridad ('http://', 'https://', 'ftp://',
# 'gemini://', 'ssh://', ...) o 'mailto:'. 'file://' NO cuenta a propósito: eso es una
# ruta local y la maneja la rama de archivos, que le saca el prefijo y la resuelve.
es_url() {
    case "$1" in file://*) return 1 ;; esac
    [[ $1 =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]]+$ ]] ||
        [[ $1 =~ ^mailto:[^[:space:]]+$ ]]
}

# Limpieza específica de una RUTA: el 'file://' que ponen navegadores y gestores y los
# escapes de URL ('%20'). Acá SÍ se decodifica; en una URL no se toca (ver abajo).
#
# Sólo se decodifica si TODOS los '%' son un escape válido y no hay backslashes:
# 'printf %b' también interpreta '\', así que un nombre con '\' se vería alterado, y un
# '%' suelto haría saltar un error de printf.
limpiar_ruta() {
    local r
    r=$(limpiar_basico "$1")
    r=${r#file://}

    if [[ $r == *%* && $r != *\\* ]] &&
       [[ ! $r =~ %[^0-9A-Fa-f] && ! $r =~ %$ ]]; then
        r=$(printf '%b' "${r//%/\\x}")
    fi

    printf '%s' "$r"
}

# Analiza UNA línea del portapapeles y decide qué es. Imprime:
#   'url<TAB><url>'            una URL, tal cual (sin decodificar)
#   'ok<TAB>/ruta/absoluta'    es una ruta y existe
#   'falta<TAB>/ruta/absoluta' parece ruta y no existe
# No imprime nada si no parece ni ruta ni URL (texto suelto: no se ofrece, para no
# llenar el menú de prosa).
analizar_candidato() {
    local basico ruta abs
    basico=$(limpiar_basico "$1")
    [ -n "$basico" ] || return 0

    # La URL se detecta ANTES y se devuelve SIN TOCAR. Pasarla por limpiar_ruta la
    # rompería: '%20' se volvería un espacio y '%2F' una barra, y dejaría de apuntar a
    # lo mismo.
    if es_url "$basico"; then printf 'url\t%s' "$basico"; return 0; fi

    ruta=$(limpiar_ruta "$basico")
    [ -n "$ruta" ] || return 0

    # Parece ruta si arranca como tal o si existe tal cual. Así una frase con barras
    # ('avisar en /etc/hosts y seguir') no entra: no arranca con '/' ni existe entera.
    #
    # '~' y '~/'* van ENTRE COMILLAS a propósito: en los patrones de un 'case' bash
    # también hace expansión de tilde, así que un '~/*' pelado se convierte en
    # '/home/rodrigo/*' y nunca matchea el '~/algo' literal que llega acá.
    case "$ruta" in
        "~"|"~/"*|/*|./*|../*) ;;
        *) [ -e "$ruta" ] || return 0 ;;
    esac

    abs=$(resolver "$ruta")

    # Copiar desde un editor o desde un grep agrega ':línea[:columna]'. Se prueba sin
    # ese sufijo SÓLO si la ruta con sufijo no existe: así un nombre que de verdad
    # termina en ':12' no se corta.
    #
    # El patrón usa [^:]* y no .*: con .* (greedy) el grupo se queda con el ÚLTIMO
    # ':12' y '/a/b:12:3' daría '/a/b:12', que tampoco existe. Con [^:]* corta en el
    # PRIMER ':' y el grupo es la ruta real.
    if [ ! -e "$abs" ] && [[ $abs =~ ^([^:]*):[0-9]+(:[0-9]+)?$ ]]; then
        local sin_sufijo
        sin_sufijo=$(resolver "${BASH_REMATCH[1]}")
        if [ -e "$sin_sufijo" ]; then abs=$sin_sufijo; fi
    fi

    if [ -e "$abs" ]; then printf 'ok\t%s' "$abs"
    else                   printf 'falta\t%s' "$abs"; fi
}

abrir() {
    # Una URL va directo a xdg-open (el navegador / manejador por defecto). No se
    # resuelve ni se le busca mime: no es un archivo, y resolver() la destrozaría. Si el
    # esquema no tiene manejador se avisa, igual que cuando un tipo no tiene app.
    if es_url "$1"; then
        # xdg-mime pide el esquema en minúsculas: 'HTTPS://x' normaliza a 'https'.
        local esquema=${1%%:*}
        esquema=${esquema,,}
        if [ -z "$(xdg-mime query default "x-scheme-handler/$esquema" 2> /dev/null)" ]; then
            local sin_handler="Sin aplicación para el esquema $esquema"
            notify-send "Abrir enlace" "$sin_handler" 2> /dev/null || printf '%s\n' "$sin_handler" >&2
            return 1
        fi
        setsid -f xdg-open "$1" > /dev/null 2>&1
        return 0
    fi

    local absoluta
    absoluta=$(resolver "$1")

    # Si no existe, se avisa y se corta. Cubre dos casos: una ruta tipeada a mano con
    # un error, y una fila del portapapeles que se mostró marcada "no existe" (el
    # usuario pidió verla pero no abrirla).
    if [ ! -e "$absoluta" ]; then
        local aviso="No existe: $absoluta"
        notify-send "Abrir archivo" "$aviso" 2> /dev/null || printf '%s\n' "$aviso" >&2
        return 1
    fi

    # setsid -f desprende el visor del script. Sin eso el proceso queda colgado de la
    # vida de xdg-open: en el caso del bind, Hyprland tendría un hijo por cada archivo
    # abierto; en el de la terminal, la shell quedaría bloqueada hasta cerrar el visor.
    #
    # El desprendimiento tiene un costo: los errores del visor ya no vuelven acá (el
    # fallo ocurre después del fork). Lo que sí se detecta antes es el caso frecuente
    # -- que el tipo de archivo no tenga aplicación asociada en mimeapps.list -- y de
    # ese sí se avisa, porque si no el atajo parece no hacer nada.
    local tipo
    tipo=$(xdg-mime query filetype "$absoluta" 2> /dev/null || true)
    if [ -n "$tipo" ] && [ -z "$(xdg-mime query default "$tipo" 2> /dev/null)" ]; then
        local sin_app="Sin aplicación por defecto para $tipo"
        notify-send "Abrir archivo" "$sin_app" 2> /dev/null || printf '%s\n' "$sin_app" >&2
        return 1
    fi

    setsid -f xdg-open "$absoluta" > /dev/null 2>&1
}

if [ "$frontend" = rofi ]; then
    # Dos columnas: nombre a la izquierda, carpeta a la derecha. El nombre es lo que uno
    # recuerda y la carpeta lo que desempata entre los diez 'README.md' del disco.
    #
    # La ruta completa viaja como PRIMERA columna y no se muestra: rofi dibuja sólo las
    # columnas de -display-columns pero DEVUELVE la línea entera, así que la ruta llega
    # de vuelta sin ensuciar el menú. Es el mismo truco que usa pick-window con la
    # dirección de la ventana.
    lista=$(fd --type f --hidden --follow "${excluir[@]}" . | awk -F/ '
        {
            nombre  = $NF
            # -1 para comerse también la barra que separa carpeta de nombre. Si el
            # archivo está suelto en ~ no hay carpeta y queda "~" pelado.
            carpeta = (length($0) > length(nombre)) \
                ? "~/" substr($0, 1, length($0) - length(nombre) - 1) \
                : "~"
            printf "%s\t%s\t%s\n", $0, nombre, carpeta
        }')

    # ── Lo que tengas copiado ────────────────────────────────────────────────
    # Si lo último copiado es una ruta (copy-path, screenshot-path, un editor) o una URL
    # (un navegador), se ofrece ARRIBA y preseleccionada: Enter sin escribir nada abre
    # eso. Es el atajo para "abrir lo que tengo copiado" sin cambiar de aplicación.
    #
    # Hay razones por las que fd no listaría una ruta aunque el archivo exista: está
    # fuera de ~ (fd sólo escanea ~) o adentro de una carpeta excluida de la lista de
    # arriba. Acá eso da igual: se arma la fila a mano y se la clava al tope. Después se
    # la quita de la lista base para no verla dos veces.
    #
    # Las filas se arman EN EL ORDEN del portapapeles, mezclando URLs y rutas tal como
    # vinieron. Cada una se etiqueta en la columna de carpeta: '[portapapeles] url',
    # '~/dir' o '[portapapeles] no existe'.
    #
    # Sólo en la cara rofi, a propósito: en fzf (que arranca con una query filtrable) una
    # fila pegada al tope es una trampa, porque Enter también selecciona y no hay forma
    # de sacarla si estorba. En rofi se va tipeando y deja de molestar.
    filas_clip=()
    n_url=0
    n_falta=0
    if command -v wl-paste > /dev/null 2>&1; then
        # -n: sin el salto de línea final. head: unas pocas líneas alcanzan, y así un
        # texto enorme no se lee entero. timeout: un dueño del portapapeles colgado no
        # puede colgar el atajo. Si no hay texto (p. ej. copiaste una imagen), wl-paste
        # sale distinto de cero y no se ofrece nada.
        limite=5
        portapapeles=$(timeout 1 wl-paste -n 2> /dev/null | head -n "$limite" || true)

        while IFS= read -r linea; do
            [ -n "$linea" ] || continue
            analisis=$(analizar_candidato "$linea")
            [ -n "$analisis" ] || continue
            estado=${analisis%%$'\t'*}
            valor=${analisis#*$'\t'}

            case "$estado" in
                url)
                    n_url=$((n_url + 1))
                    filas_clip+=("$(printf '%s\t%s\t%s' "$valor" "$valor" '[portapapeles] url')")
                    ;;
                *)
                    # La carpeta se muestra con '~' para no perder de vista dónde está.
                    # El '~' del reemplazo va ENTRE COMILLAS: pelado, bash lo expande a
                    # $HOME y el reemplazo queda en nada (misma trampa que en 'case' y en
                    # ${r#~/}).
                    contenedor=${valor%/*}
                    contenedor=${contenedor/#"$HOME"/"~"}

                    if [ "$estado" = ok ]; then
                        filas_clip+=("$(printf '%s\t%s\t%s' "$valor" "$(basename -- "$valor")" "[portapapeles] $contenedor")")
                    else
                        n_falta=$((n_falta + 1))
                        filas_clip+=("$(printf '%s\t%s\t%s' "$valor" "$(basename -- "$valor")" '[portapapeles] no existe')")
                    fi
                    ;;
            esac
        done <<< "$portapapeles"
    fi

    # Quitar de la lista base lo que ya subimos como fila del portapapeles. Se compara
    # por la ruta relativa a ~, que es como vienen las líneas de fd.
    if [ "${#filas_clip[@]}" -gt 0 ]; then
        relativas=""
        for fila in "${filas_clip[@]}"; do
            r=${fila%%$'\t'*}
            case "$r" in "$HOME"/*) relativas+="${r#"$HOME"/}"$'\n' ;; esac
        done
        if [ -n "$relativas" ]; then
            lista=$(printf '%s\n' "$lista" | awk -F'\t' -v rels="$relativas" '
                BEGIN { n = split(rels, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") saltar[a[i]] = 1 }
                !($1 in saltar)')
        fi
    fi

    # Sin nada que mostrar (ni archivos en ~ ni ruta del portapapeles) no tiene sentido
    # abrir el menú: 'printf' de una cadena vacía le daría a rofi una línea en blanco y
    # el menú saldría con una entrada fantasma.
    if [ "${#filas_clip[@]}" -eq 0 ] && [ -z "$lista" ]; then
        notify-send "Archivos" "No se encontró ningún archivo en ~" 2> /dev/null || true
        exit 0
    fi

    # Las del portapapeles van arriba de las de fd. Si no hay de fd, queda sólo la
    # cadena del portapapeles (sin línea vacía de más: la sustitución de comandos se
    # come el \n final y el 'printf' de abajo repone exactamente uno).
    if [ "${#filas_clip[@]}" -gt 0 ]; then
        lista=$(printf '%s\n%s' "$(printf '%s\n' "${filas_clip[@]}")" "$lista")
    fi

    rofi_args=(
        -dmenu -i
        -p "Archivos"
        -display-columns 2,3
        -kb-custom-1 "Alt+1"
        -theme-str 'window {width: 900px;}'
    )
    if [ "${#filas_clip[@]}" -gt 0 ]; then
        aviso_clip="Portapapeles: ${#filas_clip[@]}"
        if [ "$n_url" -gt 0 ]; then aviso_clip="$aviso_clip · $n_url url"; fi
        if [ "$n_falta" -gt 0 ]; then aviso_clip="$aviso_clip · $n_falta sin existir"; fi
        aviso_clip="$aviso_clip — Alt+1 abre la primera"
        rofi_args+=( -mesg "$aviso_clip" )
    fi

    # El '|| rofi_rc=$?' captura el código sin que 'set -e' corte el script: hace falta
    # distinguir "canceló" (1) de "apretó Alt+1" (10, la kb-custom-1).
    rofi_rc=0
    seleccion=$(printf '%s\n' "$lista" | rofi "${rofi_args[@]}") || rofi_rc=$?

    # Alt+1: no importa qué fila haya dejado resaltada el filtro, la orden es abrir la
    # primera del portapapeles. rofi igual imprime la fila resaltada en stdout; se
    # ignora y se usa la que ya tenemos guardada.
    if [ "$rofi_rc" -eq 10 ] && [ "${#filas_clip[@]}" -gt 0 ]; then
        abrir "${filas_clip[0]%%$'\t'*}"
        exit 0
    fi

    [ "$rofi_rc" -eq 0 ] || exit 0
    [ -n "$seleccion" ] || exit 0
    abrir "${seleccion%%$'\t'*}"
else
    # El preview mira primero si el archivo es binario. Sin ese guard, previsualizar un
    # PDF o una imagen -- que son justo los que uno abre con este lanzador -- vuelca
    # bytes crudos al panel y desconfigura la terminal. Para esos se muestra qué son y
    # cuánto pesan, que es la única información útil que tienen antes de abrirlos.
    #
    # bat va con fallback a head porque no está instalado en todas las máquinas donde
    # se clona este repo; mismo patrón que los widgets de zshrc.local.
    preview='
        if file -bL --mime -- {} | grep -q charset=binary; then
            file -bL -- {}
            printf "Tamaño: "; du -h -- {} | cut -f1
        else
            bat --style=numbers --color=always -- {} 2>/dev/null || head -n 200 -- {}
        fi'

    # --multi para abrir varias de una (Tab marca). Sin --height: acá el menú es toda
    # la razón de ser del comando, no un accesorio de la línea de edición como en los
    # widgets de zsh, así que se queda con la pantalla entera y el preview se ve.
    seleccion=$(fd --type f --hidden --follow "${excluir[@]}" . |
        fzf --multi --height=100% \
            --prompt 'abrir ~> ' \
            --header 'Enter abre con la app por defecto   Tab marca varios' \
            --preview "$preview") || exit 0

    [ -n "$seleccion" ] || exit 0

    # Una llamada a abrir() por línea. El IFS vacío y el -r evitan que un nombre con
    # espacios o con barras invertidas llegue partido o alterado.
    while IFS= read -r archivo; do
        [ -n "$archivo" ] && abrir "$archivo"
    done <<< "$seleccion"
fi
