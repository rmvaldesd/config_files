#!/usr/bin/env bash
# Finds a file anywhere under ~ and opens it with its default application.
# One script with two faces, depending on where it's called from:
#
#   find-file          picks the frontend: rofi from the keybind, fzf in a terminal
#   find-file --rofi   forces the rofi menu
#   find-file --fzf    forces fzf with preview (lets you pick several with Tab)
#
# From the keybind (SUPER + F), the rofi face also looks at the clipboard: if the last
# thing copied is a path or a URL, it is offered at the TOP and preselected, so Enter
# without typing anything opens it (see the "What you have copied" block below). The fzf
# face deliberately does not. See clean_basic/clean_path/is_url/analyze_candidate.
#
# Detection is by TTY, not by environment variables: Hyprland launches keybinds without a
# terminal, so there stdin is not a tty and rofi comes out; in an interactive terminal it
# is one and fzf comes out. That is the only reliable signal -- WAYLAND_DISPLAY, for
# example, is set in BOTH cases, because the terminal is also a Wayland client.
#
# Why a script and not 'rofi -show recursivebrowser' (which exists in rofi 2.0 and opens
# with xdg-open on its own): that mode uses its own scanner, with no way to exclude
# anything. It ends up listing the tens of thousands of cache files on this disk, which
# are not things one wants to open, and burying the ones that are. With fd we exclude
# them and ~4,700 real entries are left, generated in under 100 ms.

set -euo pipefail

frontend=auto
case "${1:-}" in
    --rofi) frontend=rofi ;;
    --fzf)  frontend=fzf ;;
    "")     ;;
    *)      printf 'usage: %s [--rofi|--fzf]\n' "$0" >&2; exit 1 ;;
esac

if [ "$frontend" = auto ]; then
    if [ -t 0 ] && [ -t 1 ]; then frontend=fzf; else frontend=rofi; fi
fi

# --hidden is required: fd skips hidden files by default, and without it ~/.config, which
# is edited by hand, would be invisible. That is exactly why the hidden directories that
# are app cache or state have to be removed by hand.
#
# This list is the SAME as the one in the fzf widgets of zshrc.local (_fzf_home_ex_fd), on
# purpose: so that searching from the terminal and searching from the desktop don't return
# different universes. If you touch one, touch the other.
#
# The second block is dependency caches, and it is the one that changes things most:
# without it, the Go module cache alone adds 27,216 of the 34,336 entries -- 79% of the
# menu -- and buries what you are looking for. Measured here: 34,336 entries vs 4,724.
exclude=(
    --exclude=.git
    --exclude=.cache
    --exclude=.cargo
    --exclude=.claude
    --exclude=.local/share
    --exclude=.local/state

    --exclude=go/pkg      # Go module cache, read-only
    --exclude=.npm        # npm cache
    --exclude=node_modules
    --exclude=.oh-my-zsh  # framework code, not own configuration
)

# fd runs FROM ~ so it emits relative paths: those look better in both menus
# ('Documents/report.pdf' instead of '/home/rodrigo/Documents/report.pdf') and also let
# the fzf preview work without rebuilding anything, because fzf inherits this same
# directory. The absolute path is restored by open_target().
cd "$HOME"

# Returns the ABSOLUTE path for whatever it is given. It accepts the three shapes that
# arrive here: the ~-relative one produced by the fd list ('Documents/x.pdf'), an absolute
# one typed by hand ('/etc/hosts') and one with '~' ('~/x'). This used to be resolved by
# prepending $HOME to EVERYTHING without looking, so '/etc/hosts' ended up as
# '/home/rodrigo//etc/hosts' and '~/x' as '/home/rodrigo/~/x': typing an absolute path in
# the menu did not work.
resolve_path() {
    local r=$1
    case "$r" in
        "~")   r=$HOME ;;
        # ${r:2} and not ${r#~/}: as in 'case', bash would tilde-expand the '~/' pattern
        # and trim nothing, leaving '$HOME/~/x'.
        "~/"*) r="$HOME/${r:2}" ;;
    esac
    realpath -m -- "$r"
}

# Cleanup COMMON to any candidate: strips the wrapping that copied text usually arrives
# with, whether it later turns out to be a path or a URL. Trailing CR (copied from
# Windows), surrounding spaces, surrounding quotes and the '<...>' of an email or markdown.
clean_basic() {
    local r=$1

    r=${r%$'\r'}
    r=${r#"${r%%[![:space:]]*}"}
    r=${r%"${r##*[![:space:]]}"}
    r=${r#\"}; r=${r%\"}
    r=${r#\'}; r=${r%\'}
    # '<https://...>' only if BOTH are present, so a lone '>' is not eaten.
    case "$r" in "<"*">") r=${r#<}; r=${r%>} ;; esac

    printf '%s' "$r"
}

# Is this a URL? Any scheme with an authority ('http://', 'https://', 'ftp://',
# 'gemini://', 'ssh://', ...) or 'mailto:'. 'file://' does NOT count on purpose: that is a
# local path and is handled by the file branch, which strips the prefix and resolves it.
is_url() {
    case "$1" in file://*) return 1 ;; esac
    [[ $1 =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]]+$ ]] ||
        [[ $1 =~ ^mailto:[^[:space:]]+$ ]]
}

# Cleanup specific to a PATH: the 'file://' added by browsers and file managers, and the
# URL escapes ('%20'). Here it IS decoded; in a URL it is not touched (see below).
#
# It is only decoded if ALL the '%' are a valid escape and there are no backslashes:
# 'printf %b' also interprets '\', so a name with '\' would be altered, and a lone '%'
# would make printf throw an error.
clean_path() {
    local r
    r=$(clean_basic "$1")
    r=${r#file://}

    if [[ $r == *%* && $r != *\\* ]] &&
       [[ ! $r =~ %[^0-9A-Fa-f] && ! $r =~ %$ ]]; then
        r=$(printf '%b' "${r//%/\\x}")
    fi

    printf '%s' "$r"
}

# Analyzes ONE clipboard line and decides what it is. It prints:
#   'url<TAB><url>'            a URL, as is (not decoded)
#   'ok<TAB>/absolute/path'    it is a path and it exists
#   'missing<TAB>/absolute/path'  it looks like a path and does not exist
# It prints nothing if it looks like neither a path nor a URL (loose text: it is not
# offered, so the menu does not fill up with prose).
analyze_candidate() {
    local basic path abs
    basic=$(clean_basic "$1")
    [ -n "$basic" ] || return 0

    # The URL is detected FIRST and returned UNTOUCHED. Running it through clean_path
    # would break it: '%20' would become a space and '%2F' a slash, and it would no longer
    # point to the same thing.
    if is_url "$basic"; then printf 'url\t%s' "$basic"; return 0; fi

    path=$(clean_path "$basic")
    [ -n "$path" ] || return 0

    # It looks like a path if it starts like one or if it exists as is. That way a
    # sentence with slashes ('ping /etc/hosts and continue') does not get in: it does not
    # start with '/' nor exists whole.
    #
    # '~' and '~/'* are QUOTED on purpose: in a 'case' pattern bash also tilde-expands,
    # so a bare '~/*' becomes '/home/rodrigo/*' and never matches the literal '~/something'
    # that arrives here.
    case "$path" in
        "~"|"~/"*|/*|./*|../*) ;;
        *) [ -e "$path" ] || return 0 ;;
    esac

    abs=$(resolve_path "$path")

    # Copying from an editor or from grep adds ':line[:column]'. It is tried without that
    # suffix ONLY if the path with the suffix does not exist: that way a name that really
    # ends in ':12' is not cut.
    #
    # The pattern uses [^:]* and not .*: with .* (greedy) the group keeps the LAST ':12'
    # and '/a/b:12:3' would give '/a/b:12', which also does not exist. With [^:]* it cuts
    # at the FIRST ':' and the group is the real path.
    if [ ! -e "$abs" ] && [[ $abs =~ ^([^:]*):[0-9]+(:[0-9]+)?$ ]]; then
        local without_suffix
        without_suffix=$(resolve_path "${BASH_REMATCH[1]}")
        if [ -e "$without_suffix" ]; then abs=$without_suffix; fi
    fi

    if [ -e "$abs" ]; then printf 'ok\t%s' "$abs"
    else                   printf 'missing\t%s' "$abs"; fi
}

open_target() {
    # A URL goes straight to xdg-open (the default browser / handler). It is not resolved
    # nor looked up for mime: it is not a file, and resolve_path() would wreck it. If the
    # scheme has no handler it warns, just like when a type has no app.
    if is_url "$1"; then
        # xdg-mime wants the scheme lowercase: 'HTTPS://x' normalizes to 'https'.
        local scheme=${1%%:*}
        scheme=${scheme,,}
        if [ -z "$(xdg-mime query default "x-scheme-handler/$scheme" 2> /dev/null)" ]; then
            local no_handler="No handler for the $scheme scheme"
            notify-send "Open link" "$no_handler" 2> /dev/null || printf '%s\n' "$no_handler" >&2
            return 1
        fi
        setsid -f xdg-open "$1" > /dev/null 2>&1
        return 0
    fi

    local absolute
    absolute=$(resolve_path "$1")

    # If it does not exist, warn and stop. Covers two cases: a path typed by hand with a
    # mistake, and a clipboard row shown as "missing" (the user asked to see it but not to
    # open it).
    if [ ! -e "$absolute" ]; then
        local warning="Does not exist: $absolute"
        notify-send "Open file" "$warning" 2> /dev/null || printf '%s\n' "$warning" >&2
        return 1
    fi

    # setsid -f detaches the viewer from the script. Without it the process hangs off the
    # life of xdg-open: in the keybind case, Hyprland would have one child per opened file;
    # in the terminal case, the shell would be blocked until the viewer is closed.
    #
    # Detaching has a cost: the viewer's errors no longer come back here (the failure
    # happens after the fork). What IS detected beforehand is the frequent case -- that the
    # file type has no application associated in mimeapps.list -- and that one does warn,
    # because otherwise the shortcut seems to do nothing.
    local file_type
    file_type=$(xdg-mime query filetype "$absolute" 2> /dev/null || true)
    if [ -n "$file_type" ] && [ -z "$(xdg-mime query default "$file_type" 2> /dev/null)" ]; then
        local missing_app="No default application for $file_type"
        notify-send "Open file" "$missing_app" 2> /dev/null || printf '%s\n' "$missing_app" >&2
        return 1
    fi

    setsid -f xdg-open "$absolute" > /dev/null 2>&1
}

if [ "$frontend" = rofi ]; then
    # Two columns: name on the left, folder on the right. The name is what one remembers
    # and the folder is what breaks the tie between the ten 'README.md' on the disk.
    #
    # The full path travels as the FIRST column and is not shown: rofi draws only the
    # columns in -display-columns but RETURNS the whole line, so the path comes back
    # without dirtying the menu. It is the same trick pick-window uses with the window
    # address.
    list_rows=$(fd --type f --hidden --follow "${exclude[@]}" . | awk -F/ '
        {
            name  = $NF
            # -1 to also eat the slash separating folder from name. If the file sits
            # loose in ~ there is no folder and it is a bare "~".
            folder = (length($0) > length(name)) \
                ? "~/" substr($0, 1, length($0) - length(name) - 1) \
                : "~"
            printf "%s\t%s\t%s\n", $0, name, folder
        }')

    # ── What you have copied ─────────────────────────────────────────────────
    # If the last thing copied is a path (copy-path, screenshot-path, an editor) or a URL
    # (a browser), it is offered at the TOP and preselected: Enter without typing anything
    # opens it. It is the shortcut for "open what I have copied" without switching apps.
    #
    # There are reasons fd would not list a path even if the file exists: it is outside ~
    # (fd only scans ~) or inside an excluded folder from the list above. Here that does
    # not matter: the row is built by hand and pinned to the top. Afterwards it is removed
    # from the base list so it is not seen twice.
    #
    # Rows are built IN CLIPBOARD ORDER, mixing URLs and paths as they came. Each one is
    # labeled in the folder column: '[clipboard] url', '~/dir' or '[clipboard] missing'.
    #
    # Only in the rofi face, on purpose: in fzf (which starts with a filterable query) a
    # row pinned to the top is a trap, because Enter also selects and there is no way to
    # move it out of the way. In rofi you type and it stops bothering you.
    clip_rows=()
    n_url=0
    n_missing=0
    if command -v wl-paste > /dev/null 2>&1; then
        # -n: no trailing newline. head: a few lines are enough, so a huge text is not
        # read whole. timeout: a hung clipboard owner cannot hang the shortcut. If there
        # is no text (e.g. you copied an image), wl-paste exits non-zero and nothing is
        # offered.
        limit=5
        clipboard=$(timeout 1 wl-paste -n 2> /dev/null | head -n "$limit" || true)

        while IFS= read -r line; do
            [ -n "$line" ] || continue
            analysis=$(analyze_candidate "$line")
            [ -n "$analysis" ] || continue
            state=${analysis%%$'\t'*}
            value=${analysis#*$'\t'}

            case "$state" in
                url)
                    n_url=$((n_url + 1))
                    clip_rows+=("$(printf '%s\t%s\t%s' "$value" "$value" '[clipboard] url')")
                    ;;
                *)
                    # The folder is shown with '~' so its location is not lost. The '~' of
                    # the replacement goes QUOTED: bare, bash expands it to $HOME and the
                    # replacement becomes nothing (same trap as in 'case' and ${r#~/}).
                    container=${value%/*}
                    container=${container/#"$HOME"/"~"}

                    if [ "$state" = ok ]; then
                        clip_rows+=("$(printf '%s\t%s\t%s' "$value" "$(basename -- "$value")" "[clipboard] $container")")
                    else
                        n_missing=$((n_missing + 1))
                        clip_rows+=("$(printf '%s\t%s\t%s' "$value" "$(basename -- "$value")" '[clipboard] missing')")
                    fi
                    ;;
            esac
        done <<< "$clipboard"
    fi

    # Remove from the base list whatever was already lifted as a clipboard row. It is
    # compared by the ~-relative path, which is how fd lines come.
    if [ "${#clip_rows[@]}" -gt 0 ]; then
        relatives=""
        for row in "${clip_rows[@]}"; do
            r=${row%%$'\t'*}
            case "$r" in "$HOME"/*) relatives+="${r#"$HOME"/}"$'\n' ;; esac
        done
        if [ -n "$relatives" ]; then
            list_rows=$(printf '%s\n' "$list_rows" | awk -F'\t' -v rels="$relatives" '
                BEGIN { n = split(rels, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") skip[a[i]] = 1 }
                !($1 in skip)')
        fi
    fi

    # With nothing to show (no files in ~ and no clipboard path) there is no point opening
    # the menu: 'printf' of an empty string would give rofi a blank line and the menu would
    # come out with a ghost entry.
    if [ "${#clip_rows[@]}" -eq 0 ] && [ -z "$list_rows" ]; then
        notify-send "Files" "No files found in ~" 2> /dev/null || true
        exit 0
    fi

    # The clipboard ones go above the fd ones. If there are none from fd, only the
    # clipboard string remains (with no extra blank line: command substitution eats the
    # trailing \n and the 'printf' below puts back exactly one).
    if [ "${#clip_rows[@]}" -gt 0 ]; then
        list_rows=$(printf '%s\n%s' "$(printf '%s\n' "${clip_rows[@]}")" "$list_rows")
    fi

    rofi_args=(
        -dmenu -i
        -p "Files"
        -display-columns 2,3
        -kb-custom-1 "Alt+1"
        -theme-str 'window {width: 900px;}'
    )
    if [ "${#clip_rows[@]}" -gt 0 ]; then
        clip_notice="Clipboard: ${#clip_rows[@]}"
        if [ "$n_url" -gt 0 ]; then clip_notice="$clip_notice · $n_url url"; fi
        if [ "$n_missing" -gt 0 ]; then clip_notice="$clip_notice · $n_missing missing"; fi
        clip_notice="$clip_notice — Alt+1 opens the first"
        rofi_args+=( -mesg "$clip_notice" )
    fi

    # The '|| rofi_rc=$?' captures the code without 'set -e' cutting the script: it is
    # needed to tell "canceled" (1) from "pressed Alt+1" (10, the kb-custom-1).
    rofi_rc=0
    selection=$(printf '%s\n' "$list_rows" | rofi "${rofi_args[@]}") || rofi_rc=$?

    # Alt+1: no matter which row the filter left highlighted, the order is to open the
    # first clipboard one. rofi still prints the highlighted row to stdout; it is ignored
    # and the one already stored is used.
    if [ "$rofi_rc" -eq 10 ] && [ "${#clip_rows[@]}" -gt 0 ]; then
        open_target "${clip_rows[0]%%$'\t'*}"
        exit 0
    fi

    [ "$rofi_rc" -eq 0 ] || exit 0
    [ -n "$selection" ] || exit 0
    open_target "${selection%%$'\t'*}"
else
    # The preview first checks whether the file is binary. Without that guard, previewing a
    # PDF or an image -- which are exactly the ones opened with this launcher -- dumps raw
    # bytes into the panel and wrecks the terminal. For those it shows what they are and
    # how much they weigh, the only useful information they have before being opened.
    #
    # bat falls back to head because it is not installed on every machine where this repo
    # is cloned; same pattern as the zshrc.local widgets.
    preview='
        if file -bL --mime -- {} | grep -q charset=binary; then
            file -bL -- {}
            printf "Size: "; du -h -- {} | cut -f1
        else
            bat --style=numbers --color=always -- {} 2>/dev/null || head -n 200 -- {}
        fi'

    # --multi to open several at once (Tab marks). No --height: here the menu is the whole
    # point of the command, not an accessory of the editing line as in the zsh widgets, so
    # it keeps the full screen and the preview is visible.
    selection=$(fd --type f --hidden --follow "${exclude[@]}" . |
        fzf --multi --height=100% \
            --prompt 'open ~> ' \
            --header 'Enter opens with the default app   Tab marks several' \
            --preview "$preview") || exit 0

    [ -n "$selection" ] || exit 0

    # One call to open_target() per line. The empty IFS and -r keep a name with spaces or
    # backslashes from arriving split or altered.
    while IFS= read -r file; do
        [ -n "$file" ] && open_target "$file"
    done <<< "$selection"
fi
