#!/usr/bin/env bash
# Le pide a waybar que se relea, pero CON FRENO: agrupa los pedidos seguidos en uno solo.
#
# Uso:
#   waybar-refresh          programa el aviso (se manda tras ~0.35s sin más pedidos)
#   waybar-refresh --now    lo manda ya, sin esperar
#
# POR QUÉ EXISTE
#
# Cambiar el ID de un workspace no genera ningún evento que waybar pueda escuchar: su
# módulo de workspaces sigue dibujando los números viejos y, peor, deja de marcar cuál
# está activo, porque el activo pasó a tener un número que la barra no conoce. La única
# forma de sacarla de ahí es SIGUSR2.
#
# El problema es que SIGUSR2 no es un refresco suave: destruye y reconstruye TODOS los
# módulos. Varios de ellos (bluetooth, perfiles de energía, batería) tienen llamadas D-Bus
# asíncronas en vuelo, y si la respuesta llega cuando el módulo que la pidió ya no existe,
# waybar se va con SIGSEGV en 'Gio::DBus::Proxy::call_finish'. Con una señal suelta la
# ventana para que eso pase es minúscula; encadenando señales, deja de serlo.
#
# Está medido, no es teoría: 25 SIGUSR2 en 2 segundos matan la barra. Y arrastrando un
# workspace de punta a punta con move-workspace se mandaban más que eso.
#
# CÓMO
#
# Freno de cola: cada pedido anota la hora y se asegura de que haya UN temporizador
# esperando. Mientras sigan llegando pedidos, el aviso se pospone; cuando pasan ~0.35s de
# silencio, se manda una sola señal. Arrastrando despacio cada paso refresca igual, porque
# la espera es más corta que el tiempo entre pulsaciones.
#
# El estado (la marca de tiempo y el lock) es COMPARTIDO por todos los que llaman acá, y
# eso es justamente la gracia: un move-workspace seguido de un sort-workspaces manda UNA
# señal, no dos pegadas.

set -euo pipefail

AHORA=0
case "${1:-}" in
    --now|-n)  AHORA=1 ;;
    --help|-h) sed -n '2,6p' "$0" | sed 's/^# \?//'; exit 0 ;;
    "")        ;;
    *)         printf 'uso: %s [--now]\n' "${0##*/}" >&2; exit 1 ;;
esac

command -v killall >/dev/null 2>&1 || exit 0
pgrep -x waybar >/dev/null 2>&1     || exit 0

if [ "$AHORA" -eq 1 ]; then
    killall -SIGUSR2 waybar 2>/dev/null || true
    exit 0
fi

RUN="${XDG_RUNTIME_DIR:-/tmp}"
MARCA="$RUN/waybar-refresh.marca"
LOCK="$RUN/waybar-refresh.lock"

ESPERA=0.35   # segundos de silencio antes de mandar la señal
LATIDO=0.15   # cada cuánto revisa el temporizador

date +%s.%N > "$MARCA"

# El 'flock -n' garantiza UN temporizador, no uno por pedido: el segundo llamado que
# llegue mientras hay uno esperando no arranca otro, sólo corre la marca de tiempo.
(
    flock -n 8 || exit 0
    while :; do
        sleep "$LATIDO"
        ultimo=$(cat "$MARCA" 2>/dev/null || echo 0)
        awk -v a="$(date +%s.%N)" -v u="$ultimo" -v e="$ESPERA" 'BEGIN{exit !(a-u>e)}' && break
    done
    killall -SIGUSR2 waybar 2>/dev/null || true
) 8>"$LOCK" &

# El temporizador tiene que sobrevivir a este proceso: es quien manda la señal.
disown 2>/dev/null || true

exit 0
