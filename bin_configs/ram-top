#!/usr/bin/env python3
#
# Qué aplicaciones se están comiendo la RAM, CONSOLIDADAS por aplicación.
#
# El problema que resuelve: los navegadores y las apps de Electron no son un proceso
# sino veinte. En htop o btop aparecen como una lista de "firefox" sueltos y no hay
# forma de ver cuánto pesa Firefox en total. Acá se suman por aplicación, y con
# '--tree' se abre el detalle de cada una.
#
# Uso:
#   ram-top                 en una terminal, arranca el modo interactivo (ver abajo)
#   ram-top -p              forzar la salida de texto, sin menú
#   ram-top firefox         sólo esa aplicación, en texto
#   ram-top -n 20           cambiar cuántas
#   ram-top -t              con el detalle de procesos de cada una
#   ram-top --rss           medir con RSS en vez de PSS (para ver la diferencia)
#
# EL MODO INTERACTIVO
#
# Se navega con teclas de vim y son dos vistas. La PRIMERA es sólo la lista: sin panel
# al costado, así entra el doble de aplicaciones y las barras no se recortan. El
# desglose aparece al entrar con Enter, que es cuando lo pediste.
#
#   j / k          bajar y subir            g / G     al primero / al último
#   Ctrl-D/Ctrl-U  media pantalla           /         buscar (Escape la cierra)
#   l o Enter      entrar a los procesos    h, q o Esc  volver a las aplicaciones
#   q              salir (en la principal)  Ctrl-O      ocultar el panel (2da vista)
#
# Ninguna tecla de la segunda vista te devuelve a la shell: 'q' ahí vuelve a las
# aplicaciones, y recién un segundo 'q' sale. Es como salir de un pager anidado.
#
# Sale en texto y no como menú cuando la salida NO es un terminal (una tubería, otro
# script) o cuando pedís una aplicación por nombre: ahí ya dijiste qué querés ver.
#
# POR QUÉ PSS Y NO RSS, QUE ES LO QUE TODO EL MUNDO MIRA
#
# Sumar el RSS de los procesos de una aplicación da un número MUY inflado, porque el
# RSS de cada hijo incluye toda la memoria que comparte con sus hermanos y con el
# padre: la misma página se cuenta una vez por proceso. Medido en este equipo sobre
# los 19 procesos de Firefox: 4964 MiB sumando RSS contra 2787 MiB reales. Un 78% de
# más, que es la diferencia entre "algo anda muy mal" y "es un navegador con pestañas
# abiertas".
#
# PSS (Proportional Set Size) reparte cada página compartida entre los procesos que la
# usan: si tres procesos comparten 30 MiB, cada uno suma 10. Sumar PSS de un grupo da
# un número que SÍ significa algo -- cuánta RAM se liberaría cerrando la aplicación --
# y por eso es lo correcto para consolidar. Sale de /proc/PID/smaps_rollup.
#
# POR QUÉ SE AGRUPA POR ANCESTRO Y NO POR CGROUP
#
# Lo natural sería agrupar por cgroup, que es como systemd separa las aplicaciones.
# Pero en este equipo NO sirve: Hyprland lanza todo dentro de la misma
# 'session-c1.scope', así que Firefox, la terminal y Obsidian caen en el mismo grupo.
# Verificado leyendo /proc/PID/cgroup.
#
# Así que se sube por el árbol de procesos hasta el primero que ya no tiene un padre
# "de sesión" -- PID 1, Hyprland, systemd, el gestor de login, o un SHELL -- y ese se
# toma como la aplicación.
#
# Que los shells corten la cadena importa en los dos sentidos: un script envoltorio no
# se roba el nombre de lo que supervisa (sin eso, waybar figuraba como "auto-reload",
# que es el script que lo lanza), y lo que arranques a mano desde la terminal aparece
# con su propio nombre en vez de sumado a ghostty -- que es lo que uno quiere ver si
# una compilación se está comiendo la RAM.
#
# LO QUE NO SE VE
#
# El PSS de los procesos de otros usuarios (demonios de root) no es legible sin
# permisos, así que quedan afuera. Son ~27 procesos en este equipo y no son
# "aplicaciones". El pie del informe dice cuántos se saltearon, para que el total no
# parezca completo cuando no lo es.

import argparse
import os
import shutil
import subprocess
import sys

# Procesos que NO son una aplicación sino el entorno que las lanza: al llegar a uno de
# estos se deja de subir y se toma el hijo como la raíz de la aplicación.
SESION = {
    "systemd", "Hyprland", "ly-dm", "login", "sshd", "init", "start-hyprland",
}

# Un script envoltorio NO es la aplicación. waybar, por ejemplo, lo lanza y lo
# supervisa auto-reload.sh: sin esto, waybar aparecía en el informe como
# "auto-reload", que esconde qué es lo que realmente está usando la memoria. Se mira
# el ejecutable REAL (que para un script es el intérprete) y no el nombre, que para
# un script es el del archivo. Lo mismo hace que lo que arranques a mano desde la
# terminal figure con su propio nombre y no sumado a ghostty.
SHELLS = {"sh", "bash", "zsh", "dash", "fish", "ksh", "ash"}

# Nombres poco informativos: si la raíz se llama así, conviene el del proceso padre
# real o el de la línea de comandos, que dice más.
GENERICOS = {"electron", "python3", "python", "node", "java", "sh", "bash", "zsh"}


def leer_procesos():
    """(pid -> datos) de todo lo que se pueda leer, con su PSS y su RSS."""
    yo = os.getuid()
    procs = {}
    sin_permiso = 0
    for entrada in os.listdir("/proc"):
        if not entrada.isdigit():
            continue
        pid = int(entrada)
        try:
            st = os.stat("/proc/%d" % pid)
            # /proc/PID/stat trae el comm entre paréntesis, y el comm puede tener
            # espacios y paréntesis adentro: por eso se corta por el ÚLTIMO ')' y no
            # se hace un split() ingenuo, que se rompe con "(sd-pam)" y similares.
            crudo = open("/proc/%d/stat" % pid).read()
            comm = crudo[crudo.index("(") + 1:crudo.rindex(")")]
            ppid = int(crudo[crudo.rindex(")") + 2:].split()[1])
        except (OSError, ValueError):
            continue

        pss = rss = None
        try:
            for linea in open("/proc/%d/smaps_rollup" % pid):
                if linea.startswith("Pss:"):
                    pss = int(linea.split()[1])
                elif linea.startswith("Rss:"):
                    rss = int(linea.split()[1])
        except PermissionError:
            sin_permiso += 1
        except OSError:
            continue

        try:
            exe_base = os.path.basename(os.readlink("/proc/%d/exe" % pid))
        except OSError:
            exe_base = comm

        procs[pid] = {
            "pid": pid, "comm": comm, "ppid": ppid, "uid": st.st_uid,
            "pss": pss or 0, "rss": rss or 0, "legible": pss is not None,
            "nombre": nombre_de(pid, comm), "exe": exe_base,
            "rol": rol_de(pid, comm),
        }
    return procs, sin_permiso, yo


def nombre_de(pid, comm):
    """Un nombre que sirva para leer, que no siempre es el del ejecutable.

    El comm de /proc/PID/stat viene cortado a 15 caracteres, así que 'teams-for-linux'
    o 'power-profile-sync' quedan mutilados, y por eso se prefiere el binario real que
    apunta 'exe'. Pero el binario tampoco alcanza en dos casos que sí pasan acá:

      - Ejecutables VERSIONADOS. claude vive en
        ~/.local/share/claude/versions/2.1.223, así que el basename es "2.1.223" y en
        el informe aparecía una fila llamada así. Si el nombre es sólo dígitos y
        puntos, el comm dice mucho más.
      - RUNTIMES genéricos. Obsidian es '/usr/lib/electron43/electron' corriendo
        '/usr/lib/obsidian/app.asar': el binario dice "electron", que no distingue una
        app de Electron de otra. En esos casos el primer argumento que no es una
        bandera identifica la aplicación de verdad -- y si es un .asar, lo que sirve es
        el nombre del DIRECTORIO que lo contiene, no el archivo (que siempre se llama
        app.asar).
    """
    try:
        base = os.path.basename(os.readlink("/proc/%d/exe" % pid))
    except OSError:
        return comm

    if base.replace(".", "").isdigit():
        return comm or base

    if base in GENERICOS:
        try:
            crudo = open("/proc/%d/cmdline" % pid).read()
        except OSError:
            crudo = ""
        # cmdline normalmente separa los argumentos con bytes NUL, pero Electron (y
        # Chromium en general) reescriben su argv y dejan TODO en un solo string
        # separado por espacios. Sin este caso, Obsidian se quedaba sin resolver y
        # aparecía en el informe como "electron".
        partes = [a for a in crudo.split("\0") if a]
        if len(partes) < 2:
            partes = [a for a in crudo.replace("\0", " ").split() if a]
        for arg in partes[1:]:
            if arg.startswith("-"):
                continue
            if arg.endswith(".asar"):
                return os.path.basename(os.path.dirname(arg)) or base
            nombre = os.path.basename(arg)
            return os.path.splitext(nombre)[0] or base
    return base


def rol_de(pid, comm):
    """Para qué sirve ESTE proceso dentro de su aplicación.

    Sin esto, el detalle de una app de Electron son siete filas que dicen "electron" y
    no se entiende cuál es cuál. Chromium y Electron marcan el rol con '--type=', así
    que de ahí sale "renderer", "gpu-process", "zygote"...

    Firefox no lo necesita: su comm ya viene con el rol puesto ("Isolated Web Co",
    "WebExtensions", "Privileged Cont"), que es lo más específico que da el kernel --
    el comm está limitado a 15 caracteres y el sitio de cada pestaña no aparece en
    /proc, así que a "qué pestaña es" no se puede llegar desde acá.
    """
    try:
        crudo = open("/proc/%d/cmdline" % pid).read()
    except OSError:
        return comm
    partes = [a for a in crudo.split("\0") if a]
    if len(partes) < 2:
        partes = [a for a in crudo.replace("\0", " ").split() if a]

    tipo = sub = None
    for a in partes:
        if a.startswith("--type="):
            tipo = a.split("=", 1)[1]
        elif a.startswith("--utility-sub-type="):
            # "network.mojom.NetworkService" -> "network", que es lo que se entiende.
            sub = a.split("=", 1)[1].split(".")[0]
    if tipo:
        return "%s: %s" % (tipo, sub) if sub else tipo
    return comm


def raiz_de(pid, procs, yo):
    """Sube por el árbol hasta la raíz de la aplicación.

    Se corta cuando el padre es PID 1, cuando el padre es un proceso de sesión (ver
    SESION), cuando el padre es de otro usuario, o cuando el padre no es legible. El
    tope de vueltas es una red contra un árbol con un ciclo, que no debería existir
    pero cuesta una línea descartar.
    """
    actual = pid
    for _ in range(64):
        p = procs.get(actual)
        if p is None:
            return actual
        padre = procs.get(p["ppid"])
        if (p["ppid"] <= 1 or padre is None
                or padre["uid"] != yo
                or padre["comm"] in SESION
                or padre["nombre"] in SESION
                or padre["exe"] in SHELLS):
            return actual
        actual = p["ppid"]
    return actual


def humano(kib):
    if kib >= 1024 * 1024:
        return "%.1f GiB" % (kib / 1024 / 1024)
    return "%.0f MiB" % (kib / 1024)


def mem_total():
    for linea in open("/proc/meminfo"):
        if linea.startswith("MemTotal:"):
            return int(linea.split()[1])
    return 0


def calcular(campo):
    """Las aplicaciones ordenadas por memoria, de mayor a menor."""
    procs, sin_permiso, yo = leer_procesos()
    apps = {}
    for p in procs.values():
        if not p["legible"] or p[campo] == 0:
            continue
        raiz = raiz_de(p["pid"], procs, yo)
        clave = procs[raiz]["nombre"] if raiz in procs else p["nombre"]
        g = apps.setdefault(clave, {"mem": 0, "procesos": [], "raiz": raiz})
        g["mem"] += p[campo]
        g["procesos"].append(p)
    return sorted(apps.items(), key=lambda kv: kv[1]["mem"], reverse=True), sin_permiso


def barra(valor, pico, ancho=12):
    """Barra proporcional a la MÁS GRANDE, no al total de RAM: con 32 GiB, todas las
    barras contra el total serían un hilito y no se compararían entre sí."""
    return "\u2588" * max(1, round(ancho * valor / pico)) if pico else ""


def lineas_lista(campo):
    """Las filas que come fzf en la vista de aplicaciones.

    Formato: nombre crudo, un TAB, y la fila ya armada. El nombre se esconde con
    '--with-nth=2..', pero fzf lo sigue teniendo como {1} para armar el preview y el
    salto a la segunda vista.
    """
    orden, _ = calcular(campo)
    if not orden:
        return []
    total = mem_total()
    ancho = max([len(k) for k, _ in orden] + [12])
    pico = orden[0][1]["mem"]
    filas = []
    for nombre, g in orden:
        pct = 100.0 * g["mem"] / total if total else 0
        filas.append("%s\t%-*s %9s %5.1f%% %4dp  %s" %
                     (nombre, ancho, nombre[:ancho], humano(g["mem"]), pct,
                      len(g["procesos"]), barra(g["mem"], pico)))
    return filas


def lineas_procesos(app, campo):
    """Las filas de la SEGUNDA vista: los procesos de una aplicación.

    Mismo truco que arriba: el PID va como primer campo escondido, para que el preview
    pueda pedir el detalle de ese proceso concreto.
    """
    orden, _ = calcular(campo)
    for nombre, g in orden:
        if nombre == app:
            procesos = sorted(g["procesos"], key=lambda x: x[campo], reverse=True)
            pico = procesos[0][campo] if procesos else 0
            filas = []
            for pr in procesos:
                etiq = app if pr["pid"] == g["raiz"] else pr["rol"]
                marca = "*" if pr["pid"] == g["raiz"] else " "
                filas.append("%d\t%s %-7d %-22s %9s  %s" %
                             (pr["pid"], marca, pr["pid"], etiq[:22],
                              humano(pr[campo]), barra(pr[campo], pico)))
            return filas
    return []


def detalle_proceso(pid):
    """Todo lo que se sabe de UN proceso, para el preview de la segunda vista.

    'Privada' es el dato que más dice y el que no se ve en ningún otro lado: es la
    memoria que sólo usa este proceso, o sea la que de verdad se libera si muere. El
    resto la comparte con sus hermanos, y por eso el total de la aplicación es mucho
    menor que la suma de los RSS.
    """
    try:
        crudo = open("/proc/%d/stat" % pid).read()
        comm = crudo[crudo.index("(") + 1:crudo.rindex(")")]
    except (OSError, ValueError):
        print("Process %d is gone." % pid)
        return 0

    m = {}
    try:
        for l in open("/proc/%d/smaps_rollup" % pid):
            if ":" in l:
                k, _, v = l.partition(":")
                partes = v.split()
                if partes and partes[0].isdigit():
                    m[k] = int(partes[0])
    except OSError:
        pass

    st = {}
    try:
        for l in open("/proc/%d/status" % pid):
            k, _, v = l.partition(":")
            st[k] = v.strip()
    except OSError:
        pass

    privada = m.get("Private_Dirty", 0) + m.get("Private_Clean", 0)
    compartida = m.get("Shared_Dirty", 0) + m.get("Shared_Clean", 0)

    print("PID %d   %s" % (pid, comm))
    print("-" * 46)
    print("  %-14s %10s   %s" % ("PSS", humano(m.get("Pss", 0)),
                                 "its share of what is shared, plus its own"))
    print("  %-14s %10s" % ("RSS", humano(m.get("Rss", 0))))
    print("  %-14s %10s   %s" % ("private", humano(privada), "freed if this process dies"))
    print("  %-14s %10s   %s" % ("shared", humano(compartida), "also used by its siblings"))
    if m.get("Swap"):
        print("  %-14s %10s" % ("en swap", humano(m["Swap"])))
    if st.get("VmHWM"):
        print("  %-14s %10s   %s" % ("peak RSS", humano(int(st["VmHWM"].split()[0])),
                                     "highest since it started"))
    if st.get("Threads"):
        print("  %-14s %10s" % ("threads", st["Threads"]))

    try:
        cmd = open("/proc/%d/cmdline" % pid).read().replace("\0", " ").strip()
    except OSError:
        cmd = ""
    if cmd:
        print()
        print("command line:")
        for i in range(0, min(len(cmd), 600), 62):
            print("  " + cmd[i:i + 62])
    return 0


def imprimir_lista(campo):
    for l in lineas_lista(campo):
        print(l)
    return 0


def imprimir_procesos(app, campo):
    for l in lineas_procesos(app, campo):
        print(l)
    return 0


# El preview a la derecha sólo entra cómodo si hay lugar para las dos cosas: la lista
# con sus barras necesita unas 55 columnas y el detalle otras 50. Por debajo de eso se
# pasa ABAJO, donde la lista conserva el ancho completo y no se le comen las barras.
#
# La condición la evalúa fzf, no este script, y esa es la gracia: se reacomoda sola al
# REDIMENSIONAR la terminal, no sólo al arrancar.
VENTANA_PREVIEW = "right,50%,border-left,<52(down,55%,border-top)"


def _fzf(lineas, prompt, header, preview=None, extra=None, teclas=()):
    """Corre fzf y devuelve el primer campo de lo elegido, o None si se salió.

    Arranca SIN campo de búsqueda ('--no-input'), y eso es lo que libera las letras
    para navegar como en vim: con el campo activo, una 'j' se escribiría en el filtro
    en vez de bajar. La búsqueda sigue estando a un '/' de distancia, igual que en vim
    o en un pager.

    Entrar y salir de la búsqueda tiene DOS sutilezas que se ven sólo al usarlo:

      - Hay que SOLTAR las letras de navegación mientras buscás. Si no, siguen atadas
        y se comen lo que escribís: buscando "ghost" quedaba "host", porque la 'g' se
        la llevaba el atajo de "ir al primero". Por eso '/' hace unbind de todas y
        Escape las vuelve a atar.
      - Escape tiene que hacer cosas distintas según dónde estés, y por eso es un
        'transform' que decide en el momento: si estás buscando, cierra la búsqueda;
        si no, sale de la vista. Sin eso, Escape saldría del programa a mitad de una
        búsqueda. Y para volver hay que usar 'search()' con la cadena vacía, NO
        'clear-query': ese último borra el texto pero deja el filtro aplicado, así que
        la lista seguía recortada aunque ya no estuvieras buscando.
    """
    letras = ["j", "k", "g", "G", "q"] + list(teclas)
    navegacion = ("j:down,k:up,g:first,G:last,"
                  "ctrl-d:half-page-down,ctrl-u:half-page-up,"
                  "ctrl-f:page-down,ctrl-b:page-up")
    buscar = "/:show-input+enable-search+unbind(%s)" % ",".join(letras)
    escape = ("esc:transform:if [[ $FZF_INPUT_STATE == enabled ]]; then "
              "echo 'search()+hide-input+disable-search+rebind(%s)'; "
              "else echo abort; fi" % ",".join(letras))
    cmd = ["fzf", "--height=100%", "--delimiter=\t", "--with-nth=2..", "--no-input",
           "--prompt", prompt, "--header", header,
           "--bind", navegacion,
           "--bind", buscar,
           "--bind", escape,
           "--bind", "q:abort"]
    # Sin preview no hay panel que mostrar ni que alternar: la primera pantalla es sólo
    # la lista, y el detalle aparece al entrar con Enter.
    if preview:
        cmd += ["--preview", preview, "--preview-window", VENTANA_PREVIEW,
                "--bind", "ctrl-o:toggle-preview"]
    if extra:
        cmd += extra
    # Se captura SÓLO stdout. fzf dibuja su interfaz en stderr y la lee del terminal:
    # con 'capture_output=True' esa interfaz se iría al pipe y no se vería nada. Es un
    # error que ninguna prueba a ciegas delata, porque sin terminal fzf tampoco dibuja.
    r = subprocess.run(cmd, input="\n".join(lineas), stdout=subprocess.PIPE, text=True)
    salida = r.stdout.strip()
    return salida.split("\t")[0] if salida else None


def interactivo(args, campo):
    """Dos vistas: las aplicaciones, y los procesos de una de ellas.

    En las dos te movés con las flechas y el panel muestra el detalle de lo que tenés
    encima. Enter en una aplicación ENTRA a sus procesos; Escape vuelve. Se navega en
    un bucle y no anidando fzf dentro de fzf, así que volver es realmente volver: la
    lista de aplicaciones se recalcula al regresar y no queda una pila de menús.

    Que Enter entre en vez de salir es lo que evita perder la pantalla principal: para
    mirar los procesos de una app ya no hay que cerrar el menú.
    """
    if not shutil.which("fzf"):
        print("ram-top: fzf is missing, and it is what draws the interactive mode.", file=sys.stderr)
        print("         Without it, 'ram-top -t' and 'ram-top <name>' still work.", file=sys.stderr)
        return 1

    yo = os.path.abspath(sys.argv[0])
    extra = " --rss" if args.rss else ""

    while True:
        lineas = lineas_lista(campo)
        if not lineas:
            print("ram-top: nothing to show", file=sys.stderr)
            return 1
        app = _fzf(
            lineas,
            "ram ~> ",
            "j/k move   l or Enter: its processes   / search   q quit",
            extra=["--bind", "ctrl-r:reload(%s --lista%s)" % (yo, extra),
             "--bind", "l:accept"],
            teclas=("l",),
        )
        if app is None:
            return 0

        while True:
            filas = lineas_procesos(app, campo)
            if not filas:
                break   # la aplicación se cerró mientras mirabas: volver a la lista
            elegido = _fzf(
                filas,
                "%s ~> " % app,
                "j/k move   h, q or Esc: back   Ctrl-O: panel",
                "%s%s --proc {1}" % (yo, extra),
                ["--bind", "ctrl-r:reload(%s --procesos %s%s)" % (yo, app, extra),
                 "--bind", "h:abort",
                 # Enter no tiene nada que hacer acá: el desglose del proceso ya está
                 # en el panel. Antes salía del programa imprimiéndolo, y eso se sentía
                 # como que la pantalla se caía -- estabas mirando y de golpe volvías a
                 # la shell con un muro de texto. Sin trabajo útil, mejor que no haga
                 # nada.
                 "--bind", "enter:ignore"],
                teclas=("h",),
            )
            # Todas las salidas de esta vista vuelven a las aplicaciones: 'h', Escape
            # y 'q'. Se sale del programa con 'q' en la vista principal, igual que uno
            # sale de un pager anidado. Así ninguna tecla te tira a la shell desde acá.
            break


def main():
    ap = argparse.ArgumentParser(
        description="Which applications are using the most RAM, grouped per application.",
        epilog="Measured with PSS, which does not double count the memory shared "
               "between the processes of one application.")
    ap.add_argument("filtro", nargs="?", help="show only the ones matching this name")
    ap.add_argument("-n", type=int, default=10, metavar="N", help="how many to show (default 10)")
    ap.add_argument("-t", "--tree", action="store_true", help="break down the processes of each one")
    ap.add_argument("--rss", action="store_true", help="measure with RSS instead of PSS (inflates: see the header)")
    ap.add_argument("-i", "--interactive", action="store_true",
                    help="force interactive mode (the default on a terminal)")
    ap.add_argument("-p", "--plano", action="store_true",
                    help="force plain text output, no menu")
    ap.add_argument("-x", "--exact", action="store_true",
                    help="the filter must match exactly, not as a substring")
    # Ocultas: las usan el preview y el Ctrl-R del modo interactivo.
    ap.add_argument("--lista", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--procesos", metavar="APP", help=argparse.SUPPRESS)
    ap.add_argument("--proc", metavar="PID", help=argparse.SUPPRESS)
    args = ap.parse_args()

    campo = "rss" if args.rss else "pss"

    # El modo interactivo es el DEFAULT cuando hay terminal y no se pidió una
    # aplicación concreta. Es el mismo criterio que usa find-file para elegir entre
    # fzf y rofi: '-t 1' pregunta si la salida es un terminal, que es el único dato
    # confiable -- si el comando está en una tubería o dentro de otro script, lo que
    # se necesita es texto, no un menú. Pedir una aplicación por nombre ya dice qué
    # querés ver, así que ahí también sale directo el texto.
    interactivo_por_defecto = (sys.stdout.isatty() and not args.filtro
                               and not args.plano and not args.lista
                               and not args.procesos and not args.proc)
    if args.interactive or interactivo_por_defecto:
        return interactivo(args, campo)
    if args.lista:
        # Sólo para el Ctrl-R del modo interactivo: reimprime la lista que come fzf.
        return imprimir_lista(campo)
    if args.procesos:
        return imprimir_procesos(args.procesos, campo)
    if args.proc:
        try:
            return detalle_proceso(int(args.proc))
        except ValueError:
            print("ram-top: --proc expects a PID", file=sys.stderr)
            return 1

    orden, sin_permiso = calcular(campo)
    if args.filtro:
        f = args.filtro.lower()
        # El modo interactivo pide coincidencia exacta: si no, ver "ghostty" mostraría
        # también cualquier otra aplicación que contenga esa palabra.
        if args.exact:
            orden = [(k, v) for k, v in orden if k.lower() == f]
        else:
            orden = [(k, v) for k, v in orden if f in k.lower()]
        if not orden:
            print("ram-top: nothing matches %r" % args.filtro, file=sys.stderr)
            return 1
        args.tree = True   # pediste una app concreta: el detalle es lo que querés ver

    total_ram = mem_total()
    mostradas = orden[: args.n]
    ancho = max([len(k) for k, _ in mostradas] + [12])
    pico = mostradas[0][1]["mem"] if mostradas else 1

    etiqueta = "RSS" if args.rss else "PSS"
    print("%-*s %10s  %6s  %5s" % (ancho, "APPLICATION", etiqueta, "%RAM", "PROC"))
    print("-" * (ancho + 28))

    for nombre, g in mostradas:
        pct = 100.0 * g["mem"] / total_ram if total_ram else 0
        # Barra proporcional a la más grande, no al total: con 32 GiB de RAM todas las
        # barras contra el total serían un hilito y no se compararían entre sí.
        barra = "█" * max(1, round(12 * g["mem"] / pico))
        print("%-*s %10s  %5.1f%%  %4d  %s"
              % (ancho, nombre[:ancho], humano(g["mem"]), pct, len(g["procesos"]), barra))

        if args.tree:
            hijos = sorted(g["procesos"], key=lambda p: p[campo], reverse=True)
            for p in hijos[:8]:
                raiz = p["pid"] == g["raiz"]
                etiq = nombre if raiz else p["rol"]
                print("    %s %-7d %-22s %9s"
                      % ("*" if raiz else " ", p["pid"], etiq[:22], humano(p[campo])))
            if len(hijos) > 8:
                resto = sum(p[campo] for p in hijos[8:])
                print("      %-30s %9s" % ("+%d more processes" % (len(hijos) - 8), humano(resto)))
            print()

    suma = sum(g["mem"] for _, g in orden)
    print("-" * (ancho + 28))
    print("%-*s %10s  %5.1f%%  %4d applications"
          % (ancho, "TOTAL", humano(suma), 100.0 * suma / total_ram if total_ram else 0, len(orden)))
    if sin_permiso:
        print("(%d processes from other users are left out: their memory is not readable without root)"
              % sin_permiso)
    if args.rss:
        print("(RSS counts shared memory once PER PROCESS: these totals are inflated)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        # Salida normal si se cierra el pager o se corta con Ctrl-C.
        sys.exit(0)
