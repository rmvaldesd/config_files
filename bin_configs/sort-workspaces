#!/usr/bin/env bash
# Renumera los workspaces de Hyprland para que queden 1..N en orden visual: la pantalla
# más a la izquierda primero, y dentro de cada pantalla el orden que ya tenían.
#
#   antes:   eDP-1 -> 1, 3, 5      DP-1 -> 2, 4, 6, 7
#   después: eDP-1 -> 1, 2, 3      DP-1 -> 4, 5, 6, 7
#
# Uso:
#   sort-workspaces              renumera
#   sort-workspaces --dry-run    muestra qué haría, sin tocar nada
#
# POR QUÉ HACE FALTA
#
# 'moveworkspacetomonitor' -- lo que hace el submapa SUPER + M -- manda un workspace a la
# otra pantalla pero se lo lleva con el número puesto. Después de reacomodar dos o tres
# quedan intercalados, y eso se nota en dos lados: waybar muestra el ID (su 'format' por
# defecto es "{id}") y la navegación relativa recorre por ID.
#
# CÓMO
#
# Con el dispatcher 'workspace.change_id' de la API Lua, que cambia el ID de un workspace
# EN EL LUGAR: no mueve ventanas, no cambia de monitor, no toca el layout ni el estado de
# pantalla completa, y el workspace activo de cada pantalla sigue siendo el mismo (con
# otro número). Es la diferencia entre renumerar y mudar: lo segundo obligaría a reinsertar
# cada ventana una por una en un workspace vacío y el tiling quedaría acomodado distinto.
#
# El renumerado se hace en DOS pasadas contra un rango temporal que arranca 100 arriba del
# ID más alto que exista. Es necesario porque una permutación tiene ciclos: si el 2 tiene
# que pasar a 3 y el 3 a 2, el primer cambio chocaría contra un número todavía ocupado.
# Los workspaces que ya están en su lugar no se tocan.
#
# NOTA SOBRE LA SINTAXIS DE hyprctl
#
# Este equipo configura Hyprland en Lua (dotconfig/hypr/hyprland.lua), y en ese modo
# 'hyprctl dispatch' NO acepta la sintaxis clásica ("dispatch workspace 3"): espera una
# expresión Lua, igual que los binds del config. Por eso acá se despacha
# 'hl.dsp.workspace.change_id({ workspace = X, id = N })' y no "changeworkspaceid X N".
#
# Los workspaces especiales (el scratchpad 'magic', de ID negativo) no se tocan: no viven
# en una pantalla ni entran en la numeración.

set -euo pipefail

DRY=0
case "${1:-}" in
    --dry-run|-n) DRY=1 ;;
    --help|-h)    sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    "")           ;;
    *)            printf 'uso: %s [--dry-run]\n' "$0" >&2; exit 1 ;;
esac

command -v hyprctl >/dev/null 2>&1 || { echo "sort-workspaces: no hay hyprctl (¿esto es Hyprland?)" >&2; exit 1; }
command -v jq      >/dev/null 2>&1 || { echo "sort-workspaces: falta jq" >&2; exit 1; }

# Las dos consultas se pueden inyectar desde archivos para probar el planificador con
# configuraciones que no están enchufadas (dos o tres pantallas, workspaces intercalados).
# Sin las variables, salen de Hyprland.
monitores_json()  { if [ -n "${WS_SORT_MONITORS:-}"   ]; then cat "$WS_SORT_MONITORS";   else hyprctl monitors -j;   fi; }
workspaces_json() { if [ -n "${WS_SORT_WORKSPACES:-}" ]; then cat "$WS_SORT_WORKSPACES"; else hyprctl workspaces -j; fi; }

cambiar_id() {
    local de="$1" a="$2"
    if [ "$DRY" -eq 1 ]; then
        printf '   %s -> %s\n' "$de" "$a"
        return 0
    fi
    hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = $de, id = $a })" >/dev/null
}


# --- 1. leer el estado -----------------------------------------------------------------
# Las pantallas se ordenan por X y después por Y: X es el criterio real (izquierda a
# derecha); el desempate por Y sólo importa con dos apiladas en la misma columna.
mons=()
while IFS= read -r nombre; do
    mons+=("$nombre")
done < <(monitores_json | jq -r 'sort_by(.x, .y)[] | .name')

[ "${#mons[@]}" -gt 0 ] || { echo "sort-workspaces: no hay pantallas" >&2; exit 1; }

# Workspaces normales (ID > 0) ordenados por ID: dentro de una pantalla no hay más "orden
# visual" que el número, así que se respeta el que ya tenían.
declare -A mon_de ventanas_de
ids=()
while IFS=$'\t' read -r id mon vent; do
    ids+=("$id")
    mon_de["$id"]="$mon"
    ventanas_de["$id"]="$vent"
done < <(workspaces_json | jq -r '[.[] | select(.id > 0)] | sort_by(.id)[] | [(.id|tostring), .monitor, (.windows|tostring)] | @tsv')

[ "${#ids[@]}" -gt 0 ] || { echo "sort-workspaces: no hay workspaces que ordenar" >&2; exit 0; }

# --- 2. calcular el orden deseado ------------------------------------------------------
orden=()   # IDs viejos, en el orden en que van a quedar
for m in "${mons[@]}"; do
    for id in "${ids[@]}"; do
        [ "${mon_de[$id]}" = "$m" ] && orden+=("$id")
    done
done

# Un workspace puede figurar en una pantalla que ya no está en la lista (pasa el instante
# posterior a desenchufar un monitor). Van al final, para no perderlos ni renumerar sobre
# ellos.
for id in "${ids[@]}"; do
    hallado=0
    for o in "${orden[@]}"; do [ "$o" = "$id" ] && { hallado=1; break; }; done
    [ "$hallado" -eq 0 ] && orden+=("$id")
done

declare -A nuevo_de
n=0
for id in "${orden[@]}"; do
    n=$(( n + 1 ))
    nuevo_de["$id"]=$n
done

cambios=0
for id in "${orden[@]}"; do
    [ "${nuevo_de[$id]}" -ne "$id" ] && cambios=$(( cambios + 1 ))
done

# --- 3. mostrar el plan ----------------------------------------------------------------
if [ "$DRY" -eq 1 ] || [ "$cambios" -eq 0 ]; then
    for m in "${mons[@]}"; do
        printf '%s\n' "$m"
        for id in "${orden[@]}"; do
            [ "${mon_de[$id]}" = "$m" ] || continue
            marca=""
            [ "${nuevo_de[$id]}" -ne "$id" ] && marca="  *"
            printf '  %3s -> %-3s  (%s ventanas)%s\n' "$id" "${nuevo_de[$id]}" "${ventanas_de[$id]}" "$marca"
        done
    done
fi

if [ "$cambios" -eq 0 ]; then
    echo "Ya están ordenados: no hay nada que mover."
    exit 0
fi

# --- 4. renumerar ----------------------------------------------------------------------
max=0
for id in "${ids[@]}"; do [ "$id" -gt "$max" ] && max=$id; done
TMP=$(( max + 100 ))

[ "$DRY" -eq 1 ] && echo "--- pasada 1: al rango temporal"
for id in "${orden[@]}"; do
    [ "${nuevo_de[$id]}" -ne "$id" ] || continue
    cambiar_id "$id" $(( TMP + nuevo_de[$id] ))
done

[ "$DRY" -eq 1 ] && echo "--- pasada 2: al número definitivo"
for id in "${orden[@]}"; do
    [ "${nuevo_de[$id]}" -ne "$id" ] || continue
    cambiar_id $(( TMP + nuevo_de[$id] )) "${nuevo_de[$id]}"
done

# --- 5. la barra se entera sola -----------------------------------------------------------
# No hay que avisarle nada a waybar: el modulo de workspaces es 'ext/workspaces', que ve
# los cambios de ID por el protocolo del compositor. Antes esto mandaba un SIGUSR2, que
# reconstruye todos los modulos y hace parpadear la barra entera. Ver el comentario
# equivalente en move-workspace y el bloque del modulo en waybar/config.jsonc.

exit 0
