#!/usr/bin/env bash
# Mueve el workspace ACTIVO a otra posición dentro de su pantalla, arrastrando a los
# demás para que la secuencia siga siendo 1..N sin huecos.
#
#   antes:   1, 2, 3, 4   (parado en el 1)
#   'move-workspace 3'
#   después: el que era 1 ahora es 3, el 2 pasó a 1 y el 3 pasó a 2. El 4 no se movió.
#
# Seguís parado en el mismo workspace, con las mismas ventanas: lo único que cambia es
# su número y, por lo tanto, su lugar en la barra y en la navegación relativa.
#
# Uso:
#   move-workspace left | right     una posición hacia ese lado
#   move-workspace <N>              a la posición N de la pantalla (1 = primera)
#   move-workspace right --dry-run  muestra qué haría, sin tocar nada
#
# POR QUÉ SÓLO DENTRO DE LA PANTALLA
#
# Esto renumera; no muda nada de sitio. Mandar un workspace a la OTRA pantalla es
# 'moveworkspacetomonitor', que es lo que hace el submapa SUPER + M. Y no tendría sentido
# mezclarlos: sort-workspaces ordena por pantalla y después por ID, así que un número
# "de la otra pantalla" se lo llevaría por delante en el próximo ordenamiento. Por eso los
# extremos se topan en vez de saltar a la pantalla vecina.
#
# Como la reordenación es sólo dentro de una pantalla y deja los mismos IDs (repartidos
# distinto), el resultado es ESTABLE frente a sort-workspaces: correrlo después no cambia
# nada. Los dos comandos se pueden usar en cualquier orden.
#
# CÓMO
#
# Igual que sort-workspaces, y por los mismos motivos: 'workspace.change_id' de la API Lua
# cambia el ID EN EL LUGAR -- no mueve ventanas, no cambia de monitor, no toca el layout ni
# el estado de pantalla completa --, y se hace en DOS pasadas contra un rango temporal
# porque una permutación tiene ciclos y el primer cambio chocaría contra un número todavía
# ocupado. La sintaxis del dispatch es Lua porque este equipo configura Hyprland en Lua
# (ver la nota en sort-workspaces).
#
# Los workspaces especiales (el scratchpad 'magic', de ID negativo) no entran: no tienen
# posición en la secuencia.

set -euo pipefail

DRY=0
destino_arg=""
for a in "$@"; do
    case "$a" in
        --dry-run|-n) DRY=1 ;;
        --help|-h)    sed -n '2,18p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)            destino_arg="$a" ;;
    esac
done

[ -n "$destino_arg" ] || { printf 'uso: %s left|right|<N> [--dry-run]\n' "${0##*/}" >&2; exit 1; }

command -v hyprctl >/dev/null 2>&1 || { echo "move-workspace: no hay hyprctl (¿esto es Hyprland?)" >&2; exit 1; }
command -v jq      >/dev/null 2>&1 || { echo "move-workspace: falta jq" >&2; exit 1; }

LOCK="${XDG_RUNTIME_DIR:-/tmp}/move-workspace.lock"

# Un movimiento a la vez. Si ya hay uno corriendo -- que pasa apretando el atajo rápido --
# esta invocación se descarta en silencio en vez de encimarse: dos renumerados
# entrelazados se pisan los IDs entre sí y dejan la secuencia hecha un nudo, porque cada
# uno leyó el estado ANTES de que el otro lo cambiara.
#
# Descartar y no encolar es lo correcto acá: lo que se pierde es un movimiento de más
# durante un arrastre, no una acción que el usuario vaya a extrañar.
if [ "$DRY" -eq 0 ]; then
    exec 9>"$LOCK"
    flock -n 9 || exit 0
fi

# Igual que en sort-workspaces: el estado se puede inyectar desde archivos para probar el
# planificador con configuraciones que no están enchufadas (muchos workspaces, el activo en
# el medio, dos pantallas). Sin las variables, sale de Hyprland.
workspaces_json() { if [ -n "${WS_MOVE_WORKSPACES:-}" ]; then cat "$WS_MOVE_WORKSPACES"; else hyprctl workspaces -j;      fi; }
activo_json()     { if [ -n "${WS_MOVE_ACTIVO:-}"     ]; then cat "$WS_MOVE_ACTIVO";     else hyprctl activeworkspace -j; fi; }

# Los cambios se ACUMULAN y se mandan todos juntos al final, en un solo 'hyprctl --batch'.
# No es micro-optimización: cada 'hyprctl' suelto es un proceso más una ida y vuelta por el
# socket, y entre uno y otro el estado intermedio es visible. Como el módulo de waybar se
# actualiza en vivo, esa ventana se veía: durante el movimiento aparecían workspaces
# numerados 109, 110... -- el rango temporal -- como si hubiera de más. En un lote, todo
# ocurre en un solo viaje.
pasos=()
apilar() { pasos+=("$1 $2"); }

aplicar() {
    local lote="" paso de a
    for paso in "${pasos[@]}"; do
        de=${paso%% *}; a=${paso##* }
        if [ "$DRY" -eq 1 ]; then
            printf '   %s -> %s\n' "$de" "$a"
            continue
        fi
        lote+="dispatch hl.dsp.workspace.change_id({ workspace = $de, id = $a }) ; "
    done
    [ "$DRY" -eq 1 ] && return 0
    [ -n "$lote" ] && hyprctl --batch "${lote% ; }" >/dev/null
    return 0
}


# --- 1. leer el estado -----------------------------------------------------------------
activo=$(activo_json | jq -r '.id')
pantalla=$(activo_json | jq -r '.monitor')

if [ "$activo" -lt 0 ] 2>/dev/null; then
    echo "move-workspace: el workspace activo es especial (scratchpad); no tiene posición." >&2
    exit 1
fi

# Sólo los de ESTA pantalla, ordenados por ID: dentro de una pantalla no hay más "posición"
# que el número.
ids=()
while IFS= read -r id; do
    ids+=("$id")
done < <(workspaces_json | jq -r --arg m "$pantalla" '[.[] | select(.id > 0 and .monitor == $m)] | sort_by(.id)[] | .id')

total=${#ids[@]}
[ "$total" -gt 1 ] || { echo "move-workspace: hay un solo workspace en $pantalla; no hay dónde moverlo."; exit 0; }

# --- 2. dónde está y a dónde va --------------------------------------------------------
desde=-1
for i in "${!ids[@]}"; do
    [ "${ids[$i]}" = "$activo" ] && { desde=$i; break; }
done
[ "$desde" -ge 0 ] || { echo "move-workspace: el workspace activo ($activo) no figura en $pantalla." >&2; exit 1; }

case "$destino_arg" in
    left|izq|-1)  hasta=$(( desde - 1 )) ;;
    right|der|+1) hasta=$(( desde + 1 )) ;;
    ''|*[!0-9]*)  echo "move-workspace: destino inválido '$destino_arg' (left, right o un número)" >&2; exit 1 ;;
    # Posición absoluta, 1-based: la que ve el usuario en la barra.
    *)            hasta=$(( destino_arg - 1 )) ;;
esac

# Los extremos se topan y no dan error: mantener apretado el atajo contra el borde no
# debería quejarse ni, mucho menos, saltar a la otra pantalla.
[ "$hasta" -lt 0 ] && hasta=0
[ "$hasta" -ge "$total" ] && hasta=$(( total - 1 ))

if [ "$hasta" -eq "$desde" ]; then
    [ "$DRY" -eq 1 ] && echo "Ya está en la posición $(( desde + 1 )) de $pantalla: no hay nada que mover."
    exit 0
fi

# --- 3. calcular el nuevo reparto ------------------------------------------------------
# Se saca el activo de la lista y se lo reinserta en la posición destino. Los IDs que hay
# en la pantalla son los MISMOS: lo único que cambia es cuál le toca a cada workspace.
orden=()
for i in "${!ids[@]}"; do
    [ "$i" -eq "$desde" ] || orden+=("${ids[$i]}")
done
resto=("${orden[@]}")
orden=()
for i in "${!resto[@]}"; do
    [ "$i" -eq "$hasta" ] && orden+=("$activo")
    orden+=("${resto[$i]}")
done
# Si va al final, el bucle de arriba nunca llega a insertarlo.
[ "$hasta" -ge "${#resto[@]}" ] && orden+=("$activo")

declare -A nuevo_de
for i in "${!orden[@]}"; do
    nuevo_de["${orden[$i]}"]=${ids[$i]}
done

# --- 4. mostrar el plan ----------------------------------------------------------------
if [ "$DRY" -eq 1 ]; then
    printf '%s: posición %s -> %s\n' "$pantalla" "$(( desde + 1 ))" "$(( hasta + 1 ))"
    for id in "${orden[@]}"; do
        marca=""
        [ "${nuevo_de[$id]}" -ne "$id" ] && marca="  *"
        [ "$id" = "$activo" ] && marca="$marca  (activo)"
        printf '  %3s -> %-3s%s\n' "$id" "${nuevo_de[$id]}" "$marca"
    done
    echo "--- pasos (el temporal sólo aparece si hay un ciclo):"
fi

# --- 5. renumerar ----------------------------------------------------------------------
# El rango temporal se calcula sobre TODOS los workspaces y no sólo los de esta pantalla:
# los de la otra son IDs igual de ocupados y chocaríamos con ellos.
max=0
while IFS= read -r id; do
    [ "$id" -gt "$max" ] && max=$id
done < <(workspaces_json | jq -r '.[] | select(.id > 0) | .id')
TMP=$(( max + 100 ))

# Se emiten los pasos de forma que NUNCA se pise una etiqueta ocupada:
#   1. Mientras alguno tenga su destino LIBRE, se mueve directo. Eso resuelve las cadenas
#      (5 -> 3 cuando el 3 ya se fue, etc.) sin gastar ningún número temporal.
#   2. Cuando nadie puede avanzar, lo que queda son ciclos puros (el 2 quiere el 1 y el 1
#      quiere el 2). Se rompe UNO estacionándolo en el temporal, y se vuelve al paso 1.
#
# Por qué así y no la versión obvia: mandar TODOS al rango temporal y después todos al
# definitivo funciona, pero son el doble de pasos y deja varios números temporales visibles
# a la vez -- que es lo que se veía como workspaces fantasma al mover uno. Con esto, en el
# caso típico no aparece NINGUNO.
#
# El paso 1 no alcanza solo: sin el 2 se colgaría para siempre en un ciclo. Y el 2 no
# alcanza solo: estacionar sin mirar deja parados en el temporal a los que en realidad
# eran una cadena. Hacen falta los dos, y un test aleatorio de permutaciones lo confirma.
declare -A pend
for id in "${orden[@]}"; do
    [ "${nuevo_de[$id]}" -ne "$id" ] || continue
    pend["$id"]="${nuevo_de[$id]}"
done

# Las etiquetas EN USO son las de todos los workspaces, no sólo las de los que cambian: una
# que no se mueve igual bloquea su número.
declare -A ocupada
for id in "${ids[@]}"; do ocupada["$id"]=1; done

while [ "${#pend[@]}" -gt 0 ]; do
    progreso=0
    for de in "${!pend[@]}"; do
        a=${pend[$de]}
        [ -n "${ocupada[$a]:-}" ] && continue
        apilar "$de" "$a"
        unset 'ocupada[$de]'; ocupada["$a"]=1
        unset 'pend[$de]'
        progreso=1
    done
    if [ "$progreso" -eq 0 ]; then
        for de in "${!pend[@]}"; do
            apilar "$de" "$TMP"
            unset 'ocupada[$de]'; ocupada["$TMP"]=1
            pend["$TMP"]=${pend[$de]}
            unset 'pend[$de]'
            break
        done
    fi
done

aplicar

# --- 6. la barra se entera sola -----------------------------------------------------------
# No hay que avisarle NADA a waybar, y eso es a proposito: el modulo de workspaces es
# 'ext/workspaces', que habla el protocolo ext-workspace del compositor y ve el cambio de
# ID por su cuenta (verificado renumerando sin mandar ninguna senal).
#
# Antes esto mandaba un SIGUSR2, que es lo unico que sacaba de su error al modulo
# 'hyprland/workspaces'. Pero SIGUSR2 no es un refresco: reconstruye TODOS los modulos, la
# barra entera parpadea en cada movimiento, y encadenar esas recargas la mata con SIGSEGV
# (una respuesta D-Bus que llega cuando el modulo que la pidio ya no existe; medido: 25
# senales en 2 segundos alcanzan). Cambiar de modulo hizo desaparecer el parpadeo y el
# problema de raiz. Si alguna vez se vuelve a 'hyprland/workspaces', hay que reponer el
# aviso CON un freno que agrupe las senales: sin eso, arrastrar un workspace tira la barra.

exit 0
