# Definiciones propias de zsh. Vive en ~/config_files/zshrc.local y se enlaza
# como ~/.zshrc.local desde archdesktopinstall.sh (sección 9).
#
# ~/.zshrc ya NO se versiona: lo genera oh-my-zsh desde su template y queda como
# archivo real, así sus actualizaciones y su instalador pueden tocarlo sin
# pelearse con el repo. Lo único que el script le agrega es un source de este
# archivo al final. Todo lo propio va acá.

# Binarios de usuario instalados fuera de pacman:
#   ~/.local/bin  entre otros 'claude', que su instalador oficial deja ahi.
#   ~/go/bin      lo que instala 'go install' (gopls, templ, air...). El handler
#                 de gopls esta deshabilitado a proposito en la config de nvim,
#                 asi que Mason NO lo instala y tiene que venir de aca.
#
# Se pone la ruta fija y no "$(go env GOPATH)/bin": eso obligaria a ejecutar go
# en cada arranque de shell, y dejaria el PATH roto el dia que Go no este.
# GOPATH ya apunta a ~/go, que es el default.
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

# ---------------------------------------------------------------------------
# claude
# ---------------------------------------------------------------------------
# Arranca Claude Code con el modo 'bypassPermissions' habilitado pero NO
# activo: la sesion empieza preguntando como siempre, y desde adentro se puede
# saltar a saltarse todos los permisos con Shift+Tab (ciclo de modos) o con
# /permissions. Sin este flag ese modo ni siquiera aparece como opcion.
#
# La variante --dangerously-skip-permissions (sin 'allow-') arranca directo en
# ese modo, sin preguntar nada desde el primer comando.
alias yolo='claude --allow-dangerously-skip-permissions'

# ---------------------------------------------------------------------------
# fzf
# ---------------------------------------------------------------------------
# 'fzf --zsh' emite el autocompletado y los atajos de teclado juntos. Es el
# metodo recomendado desde fzf 0.48 y no depende de rutas como
# /usr/share/fzf/*.zsh, que cambian entre distros.
#
# Este archivo se carga al final de ~/.zshrc, o sea DESPUES de oh-my-zsh, que
# es quien ejecuta compinit. El autocompletado de fzf necesita ese orden.
#
# El guard evita que la shell falle si fzf no esta instalado.
if command -v fzf > /dev/null 2>&1; then
    source <(fzf --zsh)

    # Atajos que quedan disponibles:
    #   Ctrl+F  buscar RUTAS e insertarlas en la linea de comandos
    #   Ctrl+G  buscar CONTENIDO (ripgrep) e insertar "+linea archivo"
    #   Ctrl+T  archivos del directorio actual (el que trae fzf de fabrica)
    #   Ctrl+R  buscar en el historial
    #   Alt+C   cd a un subdirectorio
    # Y el autocompletado con **<TAB>, por ejemplo: vim **<TAB>
    #
    # Adentro de Ctrl+F y Ctrl+G, para no tener que salir y volver a entrar:
    #   Ctrl+H / Ctrl+L  scope: ~ / directorio actual   (en los dos)
    #   Ctrl+F / Ctrl+D  archivos / directorios         (solo en Ctrl+F; en
    #                    grep no aplica, los resultados son siempre lineas)
    #
    # Es el patron que documenta fzf en ADVANCED.md ("Toggling between data
    # sources"), con las mismas teclas que usa el ejemplo oficial: una tecla
    # global para entrar y letras adentro para cambiar de modo, en vez de un
    # atajo global por cada combinacion. El prompt dice siempre donde estas
    # parado ("files ~>", "dirs .>", "grep ~>"), y de paso Ctrl+D sigue siendo
    # el EOF que cierra la shell.
    #
    # Lo que se pisa: Ctrl+F era forward-char en zsh (quedan las flechas y
    # Alt+F). Adentro de fzf se pisan cuatro defaults, todos con reemplazo:
    # ctrl-f forward-char (queda ->), ctrl-d delete-char (queda Supr), ctrl-h
    # backward-delete-char (queda Backspace) y ctrl-l clear-screen.

    # fd respeta .gitignore, asi que las busquedas son mas rapidas y limpias
    # que con el 'find' por defecto. Los ocultos SI se incluyen (--hidden):
    # sin eso no aparecerian ni .config ni el resto de los dotfiles, que es
    # justo lo que uno busca en este repo.
    if command -v fd > /dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi

    # Excludes para cuando la busqueda se amplia a ~ (Ctrl+H). Sin filtrar, ~
    # da 64.000 archivos y la enorme mayoria es cache; con estos quedan 6.100 y
    # se conserva .config, que es el motivo de ampliar a ~ en primer lugar. Se
    # sacan .local/share y .local/state en vez de .local entero para no perder
    # .local/bin. .claude son 33 MB de JSONL en una sola linea: un match ahi
    # llena la pantalla con una linea gigante.
    #
    # Ojo con la sintaxis, fd y rg NO se comportan igual:
    #
    #   fd  --exclude=.local/share    ancla desde la raiz de busqueda, anda.
    #   rg  --glob=!.local/share      NO anda: rg necesita **/ para que matchee
    #                                 a cualquier profundidad. Sin eso el
    #                                 exclude se ignora en silencio (6.218
    #                                 archivos en vez de 1.578) y encima rg
    #                                 saltea los ocultos salvo que se le pase
    #                                 --hidden, con lo cual buscar en ~ ni
    #                                 siquiera tocaria .config.
    #
    # Las comillas: los patrones con ** van entre comillas DOBLES porque el
    # comando lo termina corriendo una shell ('$SHELL -c'), y ahi un ** suelto
    # lo expande zsh como glob y aborta con "no matches found". Dobles y no
    # simples porque estas cadenas van anidadas dentro de un echo '...' en los
    # 'transform' de mas abajo, y una comilla simple lo cortaria en dos.
    _fzf_home_ex_fd='--exclude=.git --exclude=.cache --exclude=.cargo --exclude=.claude --exclude=.local/share --exclude=.local/state'
    _fzf_home_ex_rg='--glob=!.cache --glob=!.cargo --glob=!.claude --glob="!**/.local/share/**" --glob="!**/.local/state/**"'

    # Colores alineados con el resto del entorno (waybar, mako, rofi, ghostty):
    # acento cyan #75f1fa sobre la escala zinc. No se fija 'bg' a proposito, para
    # respetar el fondo y la transparencia de ghostty.
    export FZF_DEFAULT_OPTS="
        --height 40% --layout=reverse --border=rounded
        --color=fg+:#fafafa,bg+:#3f3f46,hl:#75f1fa,hl+:#75f1fa
        --color=info:#a1a1aa,prompt:#75f1fa,pointer:#75f1fa
        --color=marker:#75f1fa,spinner:#75f1fa,header:#71717a
        --color=border:#3f3f46"

    # Ctrl-F: buscar rutas e insertarlas en la linea de comandos. Un solo
    # widget para los cuatro estados posibles -- {archivos,directorios} x
    # {aqui,~} -- en vez de un atajo global por combinacion.
    if (( $+commands[fd] )); then
        fzf-path-widget() {
            emulate -L zsh

            local f_here="fd --type f --hidden --follow --exclude=.git"
            local d_here="fd --type d --hidden --follow --exclude=.git"
            local f_home="fd --type f --hidden --follow $_fzf_home_ex_fd . ~"
            local d_home="fd --type d --hidden --follow $_fzf_home_ex_fd . ~"

            # El prompt hace de estado y los 'transform' lo leen: asi Ctrl+F
            # sabe en que scope estaba parado, y Ctrl+H sabe si venia de
            # archivos o de directorios. Sin eso cada tecla tendria que
            # asumir la mitad del estado y pisaria la otra.
            #
            # El \$ va escapado para que lo expanda fzf al apretar la tecla y
            # no zsh al definir la funcion. El '~' del patron va entre
            # comillas porque suelto es un operador de glob en zsh.
            local -a binds=(
                --bind "ctrl-f:transform:[[ \$FZF_PROMPT == *'~'* ]] && echo 'change-prompt(files ~> )+reload($f_home)' || echo 'change-prompt(files .> )+reload($f_here)'"
                --bind "ctrl-d:transform:[[ \$FZF_PROMPT == *'~'* ]] && echo 'change-prompt(dirs ~> )+reload($d_home)' || echo 'change-prompt(dirs .> )+reload($d_here)'"
                --bind "ctrl-h:transform:[[ \$FZF_PROMPT == dirs* ]] && echo 'change-prompt(dirs ~> )+reload($d_home)' || echo 'change-prompt(files ~> )+reload($f_home)'"
                --bind "ctrl-l:transform:[[ \$FZF_PROMPT == dirs* ]] && echo 'change-prompt(dirs .> )+reload($d_here)' || echo 'change-prompt(files .> )+reload($f_here)'"
            )

            # Un solo preview para los dos modos: si es directorio muestra que
            # hay adentro, si es archivo el contenido. eza/bat si estan, ls y
            # head si no (mismo patron 'fd -> find' de la funcion imgs).
            local preview_cmd='if [ -d {} ]; then
                    (eza -1 --icons --color=always -- {} 2>/dev/null || ls -1 -- {}) | head -n 200
                else
                    bat --style=numbers --color=always -- {} 2>/dev/null || head -n 200 -- {}
                fi'

            local -a sel
            sel=("${(@f)$( eval "$f_here" 2>/dev/null |
                fzf --multi --prompt 'files .> ' \
                    --header 'Ctrl+F archivos   Ctrl+D directorios   Ctrl+H en ~   Ctrl+L aqui' \
                    --preview "$preview_cmd" "${binds[@]}" )}")

            # El (@f) siempre devuelve al menos un elemento vacio, asi que el
            # guard mira el contenido y no la cantidad.
            [[ -n ${sel[1]} ]] || { zle redisplay; return }

            # (q-): citar solo si hace falta, para que una ruta con espacios o
            # parentesis -- frecuente en el vault de Obsidian -- no se re-parta
            # en varios argumentos al apretar Enter.
            LBUFFER+="${(j: :)${(@q-)sel}}"

            # Espacio final solo si lo ultimo elegido es un archivo. Si es
            # directorio, fd ya lo emite terminado en '/' y el cursor queda
            # listo para seguir tipeando adentro (cp algo ~/dir/<sigue aca>).
            [[ -d ${sel[-1]} ]] || LBUFFER+=' '
            zle redisplay
        }
        zle -N fzf-path-widget
        bindkey '^F' fzf-path-widget
    else
        # Sin fd no hay modos ni scope; queda el widget de fabrica, que busca
        # archivos en el directorio actual y ya cita las rutas por su cuenta.
        bindkey '^F' fzf-file-widget
    fi

    # Ctrl-G: buscar por CONTENIDO con ripgrep, independiente de **<TAB> (nombres
    # de archivo) y Ctrl-T (tambien nombres). Inserta "+linea archivo" en la
    # linea de comandos, en el punto donde este el cursor -- igual que hace
    # Ctrl-T con la ruta, pero con el formato que esperan vim/nvim para abrir
    # directo en esa linea.
    #
    # --disabled deja que ripgrep haga el filtrado (una corrida nueva por cada
    # tecla, via el bind de 'change'); sin eso fzf ademas aplicaria su propio
    # fuzzy-match sobre resultados que ripgrep ya filtro, doble trabajo y mas
    # confuso. El '?? true' evita que fzf cierre el preview cuando ripgrep no
    # encuentra nada (exit code 1) o cuando el patron aun no es un regex valido
    # a mitad de tipeo.
    if (( $+commands[rg] )); then
        fzf-live-grep-widget() {
            emulate -L zsh

            # --hidden porque rg saltea los ocultos por defecto, y sin eso ni
            # .config ni los dotfiles aparecerian nunca -- que es justo lo que
            # uno busca. Al prenderlo hay que excluir .git a mano, porque deja
            # de estar cubierto por el salteo de ocultos.
            local rg_cmd='rg --column --line-number --no-heading --color=always --smart-case --hidden --glob="!.git"'
            local selected file line

            # bat con resaltado de sintaxis y la linea marcada; si no esta
            # instalado cae al 'sed' de siempre (mismo patron que 'fd -> find'
            # en la funcion imgs). '--' antes de {1} evita que un nombre de
            # archivo que empiece con '-' se interprete como flag de bat.
            local preview_cmd='
                (bat --style=numbers --color=always --highlight-line {2} -- {1} 2>/dev/null) ||
                sed -n "$(( {2}>5 ? {2}-5 : 1 )),$(( {2}+15 ))p" {1}'

            # Ctrl+H / Ctrl+L: mismo scope que en Ctrl+F. rg recibe el path
            # como argumento y los binds de fzf son cadenas fijas, asi que el
            # scope tambien vive en el prompt y cada recarga lo lee con
            # 'transform'. La diferencia con el widget de rutas es que aca el
            # 'change' de cada tecla tambien tiene que consultarlo: si no, al
            # segundo caracter tipeado la busqueda volveria sola al directorio
            # actual.
            local rg_here="$rg_cmd -- {q} || true"
            local rg_home="$rg_cmd $_fzf_home_ex_rg -- {q} ~ || true"

            selected=$(
                FZF_DEFAULT_COMMAND="$rg_cmd ''" \
                fzf --ansi --disabled \
                    --bind "change:transform:[[ \$FZF_PROMPT == *'~'* ]] && echo 'reload($rg_home)' || echo 'reload($rg_here)'" \
                    --bind "ctrl-h:change-prompt(grep ~> )+reload($rg_home)" \
                    --bind "ctrl-l:change-prompt(grep .> )+reload($rg_here)" \
                    --header 'Ctrl+H buscar en ~   Ctrl+L aqui' \
                    --delimiter : \
                    --preview "$preview_cmd" \
                    --preview-window 'down:60%:+{2}-5' \
                    --prompt 'grep .> '
            )

            [[ -n $selected ]] || { zle redisplay; return }

            file=${selected%%:*}
            line=${${(s.:.)selected}[2]}
            # (q-): cita la ruta solo si hace falta, con comillas simples.
            # Sin esto, una ruta con espacios o parentesis -- frecuente en el
            # vault de Obsidian -- se re-parte en varios argumentos al apretar
            # Enter, y los parentesis rompen con "no matches found" porque zsh
            # los toma como un patron de glob. Ctrl-T no sufre esto porque lo
            # cita fzf mismo (fzf --zsh); esta insercion es manual, asi que la
            # responsabilidad de citar es nuestra.
            LBUFFER+="+${line} ${(q-)file}"
            zle redisplay
        }
        zle -N fzf-live-grep-widget
        bindkey '^G' fzf-live-grep-widget
    fi
fi

# ---------------------------------------------------------------------------
# imgs: buscar imagenes con vista previa dentro de la terminal
# ---------------------------------------------------------------------------
# Uso:  imgs [directorio]     (por defecto, el actual)
#       Enter abre la elegida con el visor predeterminado; Esc cancela.
#
# Como funciona: ueberzugpp corre como demonio escuchando en un socket UNIX, y
# el comando de preview de fzf le manda por ahi la ruta de la imagen junto con
# las coordenadas donde dibujarla. Esas coordenadas las expone el propio fzf en
# FZF_PREVIEW_TOP/LEFT/LINES/COLUMNS.
imgs() {
    emulate -L zsh

    local bin
    for bin in fzf ueberzugpp; do
        (( $+commands[$bin] )) || { print -u2 "imgs: falta '$bin'"; return 1 }
    done

    local dir=${1:-.}
    [[ -d $dir ]] || { print -u2 "imgs: '$dir' no es un directorio"; return 1 }

    # -o kitty fija el backend en vez de dejar que ueberzugpp lo detecte:
    #
    #   NO usar --use-escape-codes aca. Ese flag hace que ueberzugpp le mande
    #   consultas a la terminal (47 bytes: ESC[?1;1;0S, ESC_Gi=31... y ESC[c) y
    #   las RESPUESTAS quedan en el buffer de entrada. Como nadie las lee, se las
    #   come fzf como si fueran teclas, y entre esos bytes va uno que dispara el
    #   accept: la imagen se abre sola sin haber tocado Enter.
    #
    # ghostty implementa el protocolo de graficos de Kitty, asi que indicarselo
    # directamente evita la consulta. El backend de Wayland no sirve: usa
    # layer-shell y posiciona mal sobre una ventana de terminal.
    # --no-stdin exige --pid-file: el demonio queda escuchando solo en el socket.
    local pidfile=$(mktemp) pid socket sel
    ueberzugpp layer --silent --no-stdin -o kitty --pid-file $pidfile
    pid=$(<$pidfile)
    socket=/tmp/ueberzugpp-${pid}.socket

    local -a buscar
    if (( $+commands[fd] )); then
        buscar=(fd --type f -e png -e jpg -e jpeg -e gif -e webp -e bmp . $dir)
    else
        buscar=(find $dir -type f \( -iname '*.png' -o -iname '*.jpg' \
                -o -iname '*.jpeg' -o -iname '*.gif' -o -iname '*.webp' \
                -o -iname '*.bmp' \))
    fi

    # El bloque 'always' garantiza que el demonio se cierre pase lo que pase:
    # seleccion normal, Esc, Ctrl+C o error. Si no, queda un proceso huerfano
    # dibujando sobre la terminal.
    {
        # Ctrl-Y copia la imagen al portapapeles y cierra. El tipo MIME se saca
        # del archivo con 'file' en vez de asumir image/png: si se copia con un
        # tipo que no corresponde, el pegado falla en la app de destino.
        # Las comillas simples son a proposito, para que el $(...) lo evalue la
        # shell de fzf al presionar la tecla y no zsh al definir la funcion.
        sel=$("${buscar[@]}" 2>/dev/null | fzf \
            --prompt 'imagen> ' \
            --header 'Enter: abrir   Ctrl-Y: copiar al portapapeles   Esc: salir' \
            --preview-window 'right:60%' \
            --bind 'ctrl-y:execute-silent(wl-copy --type "$(file -b --mime-type {})" < {} > /dev/null 2>&1; notify-send -t 3000 "Copiada al portapapeles" "$(basename {})")+abort' \
            --preview "ueberzugpp cmd -s $socket -i imgs-preview -a add \
                       -x \$FZF_PREVIEW_LEFT -y \$FZF_PREVIEW_TOP \
                       --max-width \$FZF_PREVIEW_COLUMNS \
                       --max-height \$FZF_PREVIEW_LINES -f {}")
    } always {
        ueberzugpp cmd -s $socket -a exit 2>/dev/null
        rm -f $pidfile
    }

    [[ -n $sel ]] || return 0
    print -r -- $sel
    # &! lo desacopla de la shell: cerrar la terminal no cierra el visor.
    xdg-open $sel >/dev/null 2>&1 &!
}
