# Definiciones propias de zsh. Vive en ~/config_files/zshrc.local y se enlaza
# como ~/.zshrc.local desde archdesktopinstall.sh (sección 9).
#
# ~/.zshrc ya NO se versiona: lo genera oh-my-zsh desde su template y queda como
# archivo real, así sus actualizaciones y su instalador pueden tocarlo sin
# pelearse con el repo. Lo único que el script le agrega es un source de este
# archivo al final. Todo lo propio va acá.

# Binarios de usuario instalados fuera de pacman (entre ellos 'claude', que el
# instalador oficial deja en ~/.local/bin).
export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------------------
# fzf
# ---------------------------------------------------------------------------
# 'fzf --zsh' emite el autocompletado y los atajos de teclado juntos. Es el
# metodo recomendado desde fzf 0.48 y no depende de rutas como
# /usr/share/fzf/*.zsh, que cambian entre distros.
#
# Este archivo se carga al final de ~/.zshrc, o sea DESPUES de oh-my-zsh, que
# es quien ejecuta compinit. El autocompletado de fzf necesita ese orden.
#
# El guard evita que la shell falle si fzf no esta instalado.
if command -v fzf > /dev/null 2>&1; then
    source <(fzf --zsh)

    # Atajos que quedan disponibles:
    #   Ctrl+T  insertar un archivo/directorio en la linea de comandos
    #   Ctrl+R  buscar en el historial
    #   Alt+C   cd a un subdirectorio
    # Y el autocompletado con **<TAB>, por ejemplo: vim **<TAB>

    # fd respeta .gitignore y salta los ocultos, asi que las busquedas son mas
    # rapidas y limpias que con el 'find' por defecto.
    if command -v fd > /dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi

    # Colores alineados con el resto del entorno (waybar, mako, rofi, ghostty):
    # acento cyan #75f1fa sobre la escala zinc. No se fija 'bg' a proposito, para
    # respetar el fondo y la transparencia de ghostty.
    export FZF_DEFAULT_OPTS="
        --height 40% --layout=reverse --border=rounded
        --color=fg+:#fafafa,bg+:#3f3f46,hl:#75f1fa,hl+:#75f1fa
        --color=info:#a1a1aa,prompt:#75f1fa,pointer:#75f1fa
        --color=marker:#75f1fa,spinner:#75f1fa,header:#71717a
        --color=border:#3f3f46"
fi
